+"""Literal currency-symbol witnesses bounded by physical rows in one source table."""
+import re
+from lxml import html
+from .structured_documents import parse_structured_html, _hidden
+from .table_cells import _rows_with_columns
+from .statement_amount_cells import AMOUNT
+
+
+def prove(raw, grid, unit):
+    if re.search(r"except|per share|percent|%", unit['text'], re.I):
+        raise ValueError('A uniform source scale without exceptions is required')
+    root = html.fromstring(raw)
+    tables = root.xpath(grid['table_locator'])
+    if len(tables) != 1:
+        raise ValueError('No unique original table for currency witnesses')
+    table = tables[0]
+    captions = table.xpath('./caption')
+    titles = []
+    if len(captions) == 1:
+        parts = captions[0].xpath('./p')
+        titles = [' '.join(' '.join((parts[0] if parts else captions[0]).itertext()).split())]
+    if (len(titles) != 1 or not re.fullmatch(
+            r'(?:(?:condensed|consolidated)\s+)*(?:cash flows?(?: statements?)?|statements? of cash flows?)',
+            titles[0], re.I)):
+        raise ValueError('Literal-symbol inference requires an explicit native cash-flow statement title')
+    if any(_hidden(part) for part in [*captions[0].iterancestors(), *captions[0].iter()]):
+        raise ValueError('Hidden cash-flow statement title')
+    # Reject foreign prefixes as well as competing glyphs; never strip C$/US$ to $.
+    for node in table.xpath('.//td|.//th'):
+        text = ' '.join(' '.join(node.itertext()).split())
+        if re.search(r'\b(?:shares?|counts?|units?|percent(?:ages?)?|headcount|employees?|thousands|millions|billions)\b|%|\b(?:Canadian|Australian|New Zealand|U[.]?S[.]?) dollars\b|\b(?:euros?|pounds?|yen)\b', text, re.I):
+            raise ValueError('Explicit nonuniform measurement or currency in cash-flow table')
+        if re.search(r'\b(?:USD|CAD|AUD|NZD|HKD|SGD|EUR|GBP|JPY|CNY|CHF)(?=\W|\d|$)', text, re.I):
+            raise ValueError('Explicit currency qualification conflicts with a literal-symbol-only witness')
+        if re.search(r'[$€£¥]', text):
+            match = AMOUNT.fullmatch(text)
+            if not match or match['symbol'] != '$':
+                raise ValueError('Mixed or qualified currency symbols in the original table')
+            if any(_hidden(part) for part in [*node.iterancestors(), *node.iter()]):
+                raise ValueError('Hidden currency witness')
+    parsed = parse_structured_html(raw, source_url='Original currency witness', document_id='currency-witness', snapshot_path=grid['source'])
+    hits = [t for t in parsed['tables'] if t['locator']['dom_xpath'] == grid['table_locator'] and t['status'] == 'parsed']
+    if len(hits) != 1:
+        raise ValueError('Currency table grid is ambiguous')
+    left, right = grid['common_header_interval']
+    anchors = []
+    row_indices = {}
+    for index, row in enumerate(_rows_with_columns(hits[0])):
+        for column, cell in row:
+            row_indices[cell['dom_xpath']] = index
+        content = [(column, cell) for column, cell in row if cell['text'] and column < right and left < column + cell['colspan']]
+        if len(content) != 1:
+            continue
+        column, cell = content[0]
+        match = AMOUNT.fullmatch(cell['text'])
+        if match and match['symbol'] == '$' and left <= column and column + cell['colspan'] <= right:
+            anchors.append({'row_index':index, 'locator':cell['dom_xpath'], 'text':cell['text'], 'physical_interval':[column,column+cell['colspan']]})
+    selected = [row_indices[c['locator']] for c in grid['cells']]
+    if len(anchors) < 2 or anchors[0]['row_index'] > min(selected) or anchors[-1]['row_index'] < max(selected):
+        raise ValueError('Selected rows lack physical upper and lower currency anchors')
+    return {'schema':'literal-dollar-row-band-v1', 'symbol':'$', 'currency':None,
+            'table_locator':grid['table_locator'], 'group_locator':grid['group_locator'],
+            'year_locator':grid['year_locator'], 'column_interval':[left,right],
+            'anchors':anchors, 'selected_cell_locators':[c['locator'] for c in grid['cells']],
+            'scale_locator':unit['locator'], 'scale':unit['scale'], 'ISO_currency_inferred':False}
