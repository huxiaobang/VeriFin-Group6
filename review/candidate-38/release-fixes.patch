+            ("researcher",{"claims":[claim],"summary":claim["text"],"answered_requirement_ids":["req:focus"],"unanswered_requirement_ids":[]}),
+            ("critic",{"issues":[],"reviewed_claim_ids":[claim["id"]],"reviewed_requirement_ids":["req:focus"],
+                       "request_coverage":[{"part":"part-1","status":"answered","claim_id":claim["id"],"answer_sentence":claim["text"]}]}),
