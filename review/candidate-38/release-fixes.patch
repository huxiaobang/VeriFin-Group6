+from copy import deepcopy
+import unittest
+
+from verifin.formal_subjects import catalogue_subject_claims, source_confirmed_subject_spans
+from verifin.request_review import _review_sentences, grounded_review_rows
+
+
+def document(text='Northwind Corp. Consolidated Statements of Income'):
+    return {'id':'original','kind':'document','entity':'EXAMPLE','version':1,'mode':'replay',
+            'snapshot_hash':'a'*64,'text':text}
+
+
+def claim(text,name='Northwind Corp.'):
+    value={'id':'c','text':text,'evidence_ids':['original'],'calculation_ids':[],
+           'constraints':{'entity':'EXAMPLE','period_end':'2025-06-30'},'status':'Supported'}
+    return catalogue_subject_claims([value],[{'ticker':'EXAMPLE','name':name}])[0]
+
+
+class FormalSubjectTests(unittest.TestCase):
+    def test_formal_corporate_subject_has_one_sentence_with_source_proof(self):
+        text='Northwind Corp. reported revenue of $10 million. A second assertion remains separate.'
+        rows=_review_sentences(claim(text),[document()])
+        self.assertEqual(['Northwind Corp. reported revenue of $10 million.',
+                          'A second assertion remains separate.'],rows)
+
+    def test_group_subject_and_explicit_period_prefix_are_generic(self):
+        name='Acme Co. and Subsidiaries'
+        text=f'For the quarter ended June 30, 2025, {name} reported revenue. Other information follows.'
+        source=document(name+' Condensed Consolidated Statements of Operations')
+        self.assertEqual(text.split(' Other')[0],_review_sentences(claim(text,'Acme Co.'),[source])[0])
+        wrong=claim(text,'Acme Co.')
+        wrong['constraints']['period_end']='2024-06-30'
+        self.assertFalse(source_confirmed_subject_spans(wrong,[source]))
+
+    def test_missing_uncited_stale_wrong_issuer_or_unversioned_proof_is_not_used(self):
+        item=claim('Northwind Corp. reported revenue. Source follows.')
+        for patch in [{'id':'uncited'},{'stale':True},{'entity':'OTHER'},{'version':None},
+                      {'version':True},{'snapshot_hash':None},{'kind':'source_metadata'}]:
+            with self.subTest(patch=patch):
+                self.assertFalse(source_confirmed_subject_spans(item,[{**document(),**patch}]))
+        self.assertFalse(source_confirmed_subject_spans(item,[]))
+        self.assertFalse(source_confirmed_subject_spans(item,None))
+
+    def test_mere_prose_mention_or_different_name_is_not_a_formal_heading(self):
+        item=claim('Northwind Corp. reported revenue.')
+        for text in ['Northwind Corp. reported revenue in the release.',
+                     'Elsewhere Corp. Consolidated Statements of Income']:
+            self.assertFalse(source_confirmed_subject_spans(item,[document(text)]))
+
+    def test_genuine_sentence_ends_and_prior_assertions_are_not_merged(self):
+        for text in ['The borrower was Northwind Corp. Revenue increased.',
+                     'Northwind Corp. Reported revenue increased.',
+                     'The borrower was Northwind Corp. reported results were unavailable.',
+                     'Revenue grew. Northwind Corp. reported expenses.',
+                     'The location was the U.S. Next, revenue increased.']:
+            with self.subTest(text=text):
