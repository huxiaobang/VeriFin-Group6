+"""Opt-in semantic source selection with host-checked registered identities.
+
+The model interprets the user's source intent. The host never promotes a model's
+form, issuer, publication date or original document ID into source metadata.
+"""
+import hashlib
+
+from .data import available_by, parse_day
+
+
+PLANNER_GUIDANCE = """When source_selection_pending is true, this is the first ordinary Planner step,
+not an additional role. Interpret the current source intent using the user words
+and registered source catalog only, and choose your next action in the SAME reply.
+Return source_selection={"mode":"unrestricted"} when the user leaves the sources
+open. If the user permits only named originals, select their exact registered
+IDs, including when they belong to different issuers:
+{"mode":"only","document_ids":["first original ID","second original ID"]}.
+Include all relevant issuers in scope.entities. Keep the full allowed list
+throughout the turn; a particular search can target just one of its documents.
+For restrictions by form for one issuer return {"mode":"only","entity":"registered ticker",
+"forms":["registered form"],"document_ids":["original catalog ID"],
+"document_period_end":"source document report date"}. forms/document_ids are
+optional alternatives; supplying both intersects them. Omit an unspecified source
+report date. If issuer scope is unresolved, explicitly set scope.entities in this
+same reply to the registered issuer you selected; catalog identities are not
+financial evidence. Use original IDs for a release with no registered form. Multiple IDs
+may represent a permitted union of sources; do not narrow an inclusive request
+without the user's intent. Ask a targeted clarification when source identity is
+ambiguous. Do not infer or copy financial conclusions from catalog metadata.
+The catalog may include a registered original published after the proposed cutoff.
+Selecting its identity does not permit its body or figures: the host checks its
+cutoff and local availability separately. Do not treat publication metadata as a
+financial fact. After the first step, reuse the host source scope; do not silently relax it."""
+
+
+def checked_selection(value, catalog, scope, *, identity_only=False):
+    if not isinstance(value, dict) or set(value) - {
+            "mode", "document_ids", "forms", "entity", "document_period_end"}:
+        raise ValueError("source_selection has an invalid shape")
+    mode = value.get("mode")
+    if mode not in {"unrestricted", "only"}:
+        raise ValueError("source_selection.mode must be unrestricted or only")
+    ids, forms = value.get("document_ids", []), value.get("forms", [])
+    for name, items in (("document_ids", ids), ("forms", forms)):
+        if (not isinstance(items, list) or len(items) > 50
+                or any(not isinstance(i, str) or not i.strip() for i in items)
+                or len(set(items)) != len(items)):
+            raise ValueError("source_selection." + name + " must contain unique nonempty strings")
+    entity = value.get("entity")
+    period = value.get("document_period_end")
+    if mode == "unrestricted":
+        if ids or forms or entity is not None or period is not None:
+            raise ValueError("unrestricted source selection cannot contain restrictions")
+        return {"mode": "unrestricted"}
+    if entity is None:
+        if not ids or not scope.get("entities"):
+            raise ValueError("Selecting originals without a single issuer needs exact document IDs and an issuer scope")
+    elif not isinstance(entity, str) or not entity.strip() or not (ids or forms):
+        raise ValueError("only source selection needs an entity and forms or original document IDs")
+    if period is not None:
+        if not isinstance(period, str):
+            raise ValueError("document_period_end must be an ISO date")
+        parse_day(period)
+    known = {r["document_id"]: r for r in catalog}
+    if len(known) != len(catalog):
+        raise ValueError("source catalog contains duplicate document identities")
+    # Catalog is resolved by the host under the effective issuer/cutoff scope.
+    # Explicit unknown IDs are errors, never a reason to expand to all sources.
+    if any(identifier not in known for identifier in ids):
+        raise ValueError("source_selection contains an unregistered or unavailable document ID")
+    forms = [form.upper() for form in forms]
+
+    def matches(row):
+        return (bool(row.get("entity")) and (entity is None or row["entity"].casefold() == entity.casefold())
+                and (not forms or str(row.get("form") or "").upper() in forms)
+                and (period is None or row.get("document_report_date") == period)
+                and bool(row.get("published_at"))
+                and available_by(row["published_at"], None if identity_only else scope.get("cutoff")))
+
+    if ids and any(not matches(known[identifier]) for identifier in ids):
+        raise ValueError("source_selection disagrees with registered issuer, form, period or publication cutoff")
+    selected = ids or [identifier for identifier, row in known.items() if matches(row)]
+    return {"mode": "only", "document_ids": sorted(selected), "forms": forms,
+            "entity": entity, "document_period_end": period}
+
+
+def selection_context(context, catalog):
+    """First Planner gets catalog and user words, never out-of-scope body text."""
+    users = [{"role": "user", "content": m["content"]} for m in context.get("messages", [])
+             if m.get("role") == "user"]
+    episode = context.get("episode", {})
+    return {
+        "session": {k: context["session"][k] for k in ("id", "title", "scope_version")
+                    if k in context["session"]},
+        "scope": {k: context["scope"][k] for k in ("entities", "cutoff", "period_start", "period_end")
+                  if k in context["scope"]},
+        "episode": {k: episode[k] for k in ("id", "request", "model_calls", "budget", "request_id")
+                    if k in episode},
+        "messages": users,
+        "reports": [{k: r[k] for k in ("version", "request") if k in r}
+                    for r in context.get("reports", [])],
+        "request_parts": context.get("request_parts", {}),
+        "requirements": [], "claims": [], "evidence": [], "calculations": [],
+        "tools": context.get("tools", []),
+        **({"skill_catalog": context["skill_catalog"]} if "skill_catalog" in context else {}),
+        "source_selection_pending": True,
+        "source_selection_catalog": list(catalog),
+    }
+
+
+def request_hash(request):
+    return hashlib.sha256(request.encode()).hexdigest()
+
+
+def earlier_site_receipt(report, episode):
+    """Recover a host observation for the exact outstanding question in this report."""
+    selection = episode.get("source_selection") or {}
+    finding = selection.get("previous_host_finding") or {}
+    previous = finding.get("previous_request")
+    if not previous:
+        return None
+    request = report.get("request")
+    change = episode.get("source_amendment") or {}
+    if (episode.get("id") != report.get("episode_id") or episode.get("request") != request
+            or episode.get("request_id") != report.get("request_id")
+            or previous != change.get("previous_request") or not change.get("latest_message")
+            or request != previous + "\n" + change["latest_message"]
+            or selection.get("request_sha256") != request_hash(request)):
+        return None
+    scope = report.get("scope") or {}
+    count = finding.get("eligible_registered_issuer_site_originals")
+    issuers = finding.get("entities")
+    if (type(count) is not int or count != 0 or not isinstance(issuers, list) or not issuers
+            or not all(isinstance(issuer, str) and issuer for issuer in issuers)
+            or issuers != scope.get("entities") or not finding.get("cutoff")
+            or finding["cutoff"] != scope.get("cutoff")):
+        return None
+    parts = [key for key, text in report.get("request_parts", {}).items() if text == previous]
+    if len(parts) != 1 or not any(row.get("part") == parts[0] and row.get("status") in {"gap", "partial"}
+                                  for row in report.get("request_coverage", [])):
+        return None
