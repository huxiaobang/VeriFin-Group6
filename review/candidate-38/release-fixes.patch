+    # references to current, version-bound, source-eligible text, never raw receipts.
+    source_episode = context["episode"]
+    opened = dict(source_episode.get("opened_document_versions", {}))
+    for receipt in reversed(source_episode.get("recent_tool_results", [])):
+        if (receipt.get("tool") == "read_document" and receipt.get("ok")
+                and receipt.get("scope_version") == context["session"].get("scope_version")):
+            for ref in receipt.get("evidence_ids", []):
+                version = receipt.get("record_versions", {}).get(ref)
+                if version is not None:
+                    opened.setdefault(ref, version)
+    episode["opened_document_ids"] = [
+        row["id"] for row in evidence if row.get("kind") == "document" and row["id"] in opened
+        and type(row.get("version")) is int and row["version"] == opened[row["id"]]
+    ]
+    base = {k: context[k] for k in ("session", "scope", "requirements", "request_parts",
+            "report_count", "history_omitted", "history_selection") if k in context}
+    base["messages"] = [m for m in context.get("messages", []) if m.get("role") == "user"]
+    return current_tool_receipts({**base, "episode": episode,
+        "reports": [{k: r[k] for k in ("version", "request") if k in r}
+                    for r in context.get("reports", [])],
+        "evidence": evidence, "calculations": [r for r in calculations if r["id"] in allowed],
+        "claims": claims,
+        "source_document_scope": {"document_ids": sorted(document_ids),
+            "instruction": "Use only these host-verified original documents. No outside-source evidence is available.",
+            "selection": checked},
+        "tools": [t for t in context.get("tools", []) if tool_allowed(None, t["name"])]})
