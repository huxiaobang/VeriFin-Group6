+        facts = {"cik":123,"entityName":"Example","facts":{"us-gaap":{"Revenues":{
+            "label":"Revenue","description":"Revenue","units":{"USD":[fact]}}}}}
+        self.url = "https://www.sec.gov/Archives/edgar/data/123/000000012326000001/opaque.htm"
+        files = {}
+        for name, content in (("opaque.htm",source),("opaque.txt","Original filing."),("facts.json",json.dumps(facts))):
+            raw = content.encode()
+            (self.directory/name).write_bytes(raw)
+            files[name] = {"sha256":hashlib.sha256(raw).hexdigest(),"url":self.url if name!="facts.json" else "https://data.sec.gov/api/xbrl/companyfacts/CIK0000000123.json","retrieved_at":"2026-07-10"}
+        manifest = {"companies":[{"ticker":"ABC","cik":"0000000123","name":"Example","facts":"facts.json"}],
+                    "documents":[{"entity":"ABC","source":"opaque.htm","text":"opaque.txt","form":"10-Q",
+                                  "period_end":"2026-06-13","published_at":"2026-07-09","publication_precision":"date_only","extraction_method":"separate fixture text"}],"files":files}
+        (self.directory/"manifest.json").write_text(json.dumps(manifest))
+        self.store = SessionStore(self.directory/"session.sqlite")
