+"""Source-addressed DEI filing focus; never infer a fact's fiscal duration."""
+import re
+
+from .data import DataError, stable_id
+from .reporting_period import parse_reported_date
+
+INSTANCE = "http://www.xbrl.org/2003/instance"
+INLINE = {"http://www.xbrl.org/2008/inlineXBRL", "http://www.xbrl.org/2013/inlineXBRL"}
+FIELDS = ("DocumentFiscalYearFocus", "DocumentFiscalPeriodFocus", "DocumentPeriodEndDate")
+ROLE = "reported filing-level focus only; not a fact duration or a label for comparative columns"
+
+
+def _namespace(node, prefix):
+    for parent in (node, *node.iterancestors()):
+        if value := parent.get("xmlns:" + prefix.lower()):
+            return value
+    return None
+
+
+def _expanded(node):
+    tag = node.tag
+    if not isinstance(tag, str):
+        return None, None
+    if tag.startswith("{"):
+        namespace, local = tag[1:].split("}", 1)
+        return namespace, local.lower()
+    if ":" in tag:
+        prefix, local = tag.split(":", 1)
+        return _namespace(node, prefix), local.lower()
+    return None, tag.lower()
+
+
+def _children(node, local):
+    return [child for child in node if _expanded(child) == (INSTANCE, local)]
+
+
+def _text(node):
+    return " ".join(" ".join(node.itertext()).split())
+
+
+def _cik(value):
+    value = str(value).strip()
+    return value.zfill(10) if re.fullmatch(r"\d{1,10}", value) else None
+
+
+def extract(root, company, document):
+    """Require one primary context, SEC issuer and internally consistent DEI triple.
+
+    The registered document end anchors the filing, not every statement column.
+    The context may be YTD or instant: neither becomes a quarter start here.
+    """
+    declared_form, declared_end = document.get("form"), document.get("period_end")
+    form = declared_form.removesuffix("/A") if isinstance(declared_form, str) else None
+    expected_end = parse_reported_date(declared_end) if isinstance(declared_end, str) else None
+    expected_cik = _cik(company.get("cik", ""))
+    if (company.get("ticker") != document.get("entity") or form not in ("10-Q", "10-K")
+            or not expected_end or not expected_cik):
+        return None
+    ids = {}
+    for node in root.xpath("//*[@id]"):
+        ids.setdefault(node.get("id"), []).append(node)
+    contexts = {}
+    for context_id, nodes in ids.items():
+        if len(nodes) != 1 or _expanded(nodes[0]) != (INSTANCE, "context"):
+            continue
+        node = nodes[0]
+        ancestors = {_expanded(parent) for parent in node.iterancestors()}
+        if not any((namespace, "resources") in ancestors and (namespace, "header") in ancestors for namespace in INLINE):
+            continue
+        entities, periods = _children(node, "entity"), _children(node, "period")
+        if len(entities) != 1 or len(periods) != 1 or _children(node, "scenario"):
+            continue
+        identifiers = _children(entities[0], "identifier")
+        if len(identifiers) != 1 or _children(entities[0], "segment"):
+            continue
+        identifier = identifiers[0]
+        if (identifier.get("scheme") not in ("http://www.sec.gov/CIK", "https://www.sec.gov/CIK")
+                or _cik(_text(identifier)) != expected_cik):
+            continue
+        period = periods[0]
+        parts = {name: _children(period, name) for name in ("startdate", "enddate", "instant")}
+        if len(parts["instant"]) == 1 and not parts["startdate"] and not parts["enddate"]:
+            context_period = {"instant": parse_reported_date(_text(parts["instant"][0]))}
+            end = context_period["instant"]
+        elif len(parts["startdate"]) == len(parts["enddate"]) == 1 and not parts["instant"]:
+            context_period = {"start_date": parse_reported_date(_text(parts["startdate"][0])),
+                              "end_date": parse_reported_date(_text(parts["enddate"][0]))}
+            end = context_period["end_date"]
+            if not context_period["start_date"] or not end or context_period["start_date"] > end:
+                continue
+        else:
+            continue
+        if end == expected_end:
+            contexts[context_id] = context_period
+    groups = {}
+    tree = root.getroottree()
+    for node in root.xpath("//*[@name]"):
+        namespace, local = _expanded(node)
+        if namespace not in INLINE or local != "nonnumeric" or node.get("continuedat"):
+            continue
+        prefix, separator, name = node.get("name", "").partition(":")
+        dei = _namespace(node, prefix)
+        if (not separator or name not in FIELDS or not dei
+                or not re.fullmatch(r"https?://xbrl\.sec\.gov/dei/\d{4}(?:-\d{2}-\d{2})?", dei)):
+            continue
+        context_id = node.get("contextref")
+        if context_id not in contexts or any(key.endswith(":nil") and value in ("true", "1") for key, value in node.attrib.items()):
+            continue
+        groups.setdefault(context_id, {}).setdefault(name, []).append({
+            "name": name, "raw_text": _text(node), "context_ref": context_id,
+            "locator": tree.getpath(node), "dei_namespace": dei})
+    proven = []
+    for context_id, fields in groups.items():
+        if any(len({_node["raw_text"] for _node in fields.get(name, [])}) != 1 for name in FIELDS):
+            continue
+        year, focus, printed_end = (fields[name][0]["raw_text"] for name in FIELDS)
+        if (not re.fullmatch(r"(?:19|20|21)\d{2}", year)
+                or focus not in ({"Q1", "Q2", "Q3", "Q4"} if form == "10-Q" else {"FY"})
+                or parse_reported_date(printed_end) != expected_end):
+            continue
+        proven.append({"fy": int(year), "fp": focus, "document_period_end": expected_end,
+                       "context_ref": context_id, "context_period": contexts[context_id],
+                       "cik": expected_cik, "selection_role": ROLE,
+                       "source_nodes": [entry for name in FIELDS for entry in fields[name]]})
+    return proven[0] if len(proven) == 1 else None
+
+
+def record(data, document, document_id):
+    """Build metadata from the registered original; a warm text cache is insufficient."""
+    companies = [company for company in data.manifest["companies"] if company.get("ticker") == document.get("entity")]
+    if len(companies) != 1 or not document["source"].lower().endswith((".htm", ".html")):
+        return None
+    info = data.info(document["source"])
+    if document_id != stable_id("source_doc_", info["url"]):
+        return None
+    raw = data.raw(document["source"])
+    if b"DocumentFiscalPeriodFocus" not in raw:
+        return None
+    from lxml import html
+    from lxml.etree import LxmlError
+    try:
+        focus = extract(html.fromstring(raw), companies[0], document)
+    except LxmlError:
+        return None
+    if focus is None:
+        return None
+    return {"id": stable_id("fiscal_focus_", [document_id, info["sha256"], focus]),
+            "kind": "source_metadata", "record_type": "inline_dei_fiscal_focus",
+            "entity": document["entity"], "cik": focus["cik"], "document_id": document_id,
+            "snapshot_path": document["source"], "snapshot_hash": info["sha256"], "source_url": info["url"],
+            "published_at": document["published_at"], "form": document["form"], "mode": "replay",
+            "fiscal_period_context": focus,
+            "text": f"Source-reported DEI filing focus: fiscal year {focus['fy']}, {focus['fp']}; document period ended {focus['document_period_end']}. {ROLE}.",
+            "locator": "; ".join(node["locator"] for node in focus["source_nodes"]),
+            "extraction_method": "inline-XBRL DEI facts; shared primary context, SEC CIK and registered report end jointly checked"}
+
+
+def revalidate(recorded, data):
+    documents = [doc for doc in data.manifest["documents"] if doc["source"] == recorded.get("snapshot_path")
+                 and doc["entity"] == recorded.get("entity") and doc["published_at"] == recorded.get("published_at")]
+    if len(documents) != 1:
+        raise DataError("The saved DEI focus no longer identifies one registered issuer document.")
+    document = documents[0]
+    info = data.info(document["source"])
+    data.raw(document["source"])  # Integrity failure takes priority over a missing optional parser.
+    if (recorded.get("snapshot_hash") != info["sha256"] or recorded.get("source_url") != info["url"]
+            or recorded.get("form") != document.get("form")):
+        raise DataError("The saved DEI focus source revision or registration changed; refresh required.")
+    regenerated = record(data, document, recorded.get("document_id"))
+    if not regenerated or any(recorded.get(key) != value for key, value in regenerated.items()):
+        raise DataError("The saved DEI filing focus no longer matches its original issuer, context or fiscal fields.")
