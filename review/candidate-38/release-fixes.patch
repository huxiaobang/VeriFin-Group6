+HTML = '''<table><tr><td colspan="7">Three Months Ended</td></tr>
+<tr><td colspan="7">June 30,</td></tr>
+<tr><td colspan="3"></td><td colspan="2">2025</td><td colspan="2">2024</td></tr>
+<tr><td>North Services</td><td colspan="2">Expense Change</td><td colspan="4">Operating Margin</td></tr>
+<tr><td>GAAP</td><td>9.9</td><td>%</td><td>12.5</td><td>%</td><td>14.5</td><td>%</td></tr>
+<tr><td>Non-GAAP Adjusted Measure</td><td>8.8</td><td>%</td><td>13.5</td><td>%</td><td>15.5</td><td>%</td></tr>
+<tr><td>South Services</td><td colspan="2">Expense Change</td><td colspan="4">Operating Margin</td></tr>
+<tr><td>GAAP</td><td>7.7</td><td>%</td><td>6.5</td><td>%</td><td>7.0</td><td>%</td></tr></table>'''
+
+
+class SegmentPercentageCellsTests(unittest.TestCase):
+    def cells(self, html=HTML):
+        return [r for r in index_percentages(html.encode(), DOCUMENT)
+                if r.get("cell_type") == "segment_percentage_cell"]
+
+    def test_physical_columns_and_provenance(self):
+        rows = self.cells()
+        self.assertEqual(len(rows), 6)
+        north = [r for r in rows if r["business_scope"] == "North Services" and r["basis"] == "GAAP"]
+        self.assertEqual({r["period_end"]:r["value"] for r in north}, {"2025-06-30":12.5,"2024-06-30":14.5})
+        current = next(r for r in north if r["period_end"] == "2025-06-30")
+        self.assertEqual(current["period_start"], "2025-04-01")
+        self.assertEqual(len(current["cell_locators"]), 2)
+        self.assertEqual(len(current["column_header_locators"]), 3)
+        self.assertNotIn(9.9, [r["value"] for r in rows])
+        self.assertNotIn(8.8, [r["value"] for r in rows])
+
+    def test_missing_unsupported_or_non_calendar_headers_not_guessed(self):
+        for text in [HTML.replace("June 30,", ""), HTML.replace("Three Months Ended", "Twelve Weeks Ended"),
+                     HTML.replace("June 30,", "June 29,"), HTML.replace("Operating Margin", "Expense Change"),
+                     HTML.replace("2025", "Current")]:
+            with self.subTest(text=text):
+                self.assertFalse(any(r["period_end"] == "2025-06-30" for r in self.cells(text)))
+
+    def test_absent_scope_or_unknown_basis_not_guessed(self):
+        missing = HTML.replace("<td>North Services</td>", "<td></td>").replace("<td>South Services</td>", "<td></td>")
+        self.assertEqual(self.cells(missing), [])
+        unknown = HTML.replace("<td>GAAP</td>", "<td>Forecast</td>").replace("Non-GAAP Adjusted Measure", "Scenario")
+        self.assertEqual(self.cells(unknown), [])
