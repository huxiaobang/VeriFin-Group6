+"""Physical-cell, column-period and rate-unit controls using an independent synthetic issuer."""
+import hashlib
+import unittest
+
+from verifin.data import DataError
+from verifin.unit_amount_reconstruction import inputs
+
+
+VOLUME = "Average Daily Local Package Volume (in millions)"
+RATE = "Local Package Cost Per Piece (GAAP)"
+# The issued monetary unit and the scaled count each have their own original cells.
+TABLE = f"""<table>
+<tr><td></td><td colspan='3'>Three Months Ended</td></tr>
+<tr><td></td><td colspan='3'>March 31,</td></tr>
+<tr><td></td><td></td><td>2024</td><td></td></tr>
+<tr><td>Operating Days</td><td></td><td>60</td><td></td></tr>
+<tr><td>{VOLUME}</td><td></td><td>1.25</td><td></td></tr>
+<tr><td>{RATE}</td><td>£</td><td>4.55</td><td></td></tr></table>"""
+
+
+def select(html):
+    raw = ('<html><head><meta charset="utf-8"></head><body>' + html + "</body></html>").encode()
+    doc = {"id": "source_doc_independent", "entity": "TEST", "source_url": "https://example.test/original",
+           "snapshot_path": "example.html", "snapshot_hash": hashlib.sha256(raw).hexdigest(),
+           "published_at": "2024-04-15"}
+    return inputs(raw, doc, VOLUME, RATE, "2024-01-01", "2024-03-31")
+
+
+class PhysicalUnitAmountTests(unittest.TestCase):
+    def test_selected_period_values_and_original_locators(self):
+        rows = select(TABLE)
+        self.assertEqual([r["value"] for r in rows], [60, 1250000, 4.55])
+        self.assertEqual(rows[-1]["printed_currency"], "£")
+        self.assertEqual(len({r["source_cell_id"] for r in rows}), 3)
+        self.assertTrue(all(len(r["header_xpaths"]) == 3 for r in rows))
+
+    def test_ambiguous_table_percent_suffix_missing_currency_or_wrong_duration(self):
+        bad_tables = [TABLE + TABLE,
+                      TABLE.replace("4.55</td><td></td>", "4.55</td><td>%</td>"),
+                      TABLE.replace("<td>£</td>", "<td></td>"),
+                      TABLE.replace("Three Months Ended", "Six Months Ended")]
+        for value in bad_tables:
+            with self.subTest(table=value), self.assertRaises(DataError):
+                select(value)
