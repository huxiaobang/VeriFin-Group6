+"""Literal source-symbol bands independent of issuer-specific names and numbers."""
+import copy
+import hashlib
+import unittest
+from verifin.statement_row_audit import inspect_statement_rows
+from verifin.source_row_change import reproduce
+
+RAW = b'''<html><body><table><caption><p>Cash flows</p><p>(In millions) (Unaudited)</p></caption>
+<tr><td></td><td colspan="2">Three Months Ended June 30,</td></tr>
+<tr><td></td><td>2025</td><td>2024</td></tr>
+<tr><td>Opening anchor</td><td>$100</td><td>$90</td></tr>
+<tr><td>First flow</td><td>80</td><td>60</td></tr>
+<tr><td>Second flow</td><td>(20)</td><td>(15)</td></tr>
+<tr><td>Closing anchor</td><td>$140</td><td>$135</td></tr>
+</table></body></html>'''
+
+
+def inspect(raw=RAW, year='2025'):
+    doc={'id':'source_doc_generic','entity':'XYZ','source_url':'https://example.test/release',
+         'snapshot_path':'snapshots/generic.html','snapshot_hash':hashlib.sha256(raw).hexdigest(),
+         'published_at':'2025-07-01','mode':'replay'}
+    args={'row_labels':['First flow','Second flow'],'group_header':'Three Months Ended June 30,',
+          'year_header':year,'period_start':year+'-04-01','period_end':year+'-06-30'}
+    return inspect_statement_rows(raw,doc,args)
+
+
+class LiteralCurrencySymbolTests(unittest.TestCase):
+    def test_two_columns_yield_literal_unit_without_iso(self):
+        current,prior=inspect(),inspect(year='2024')
+        value,proof=reproduce(current,prior,['First flow','Second flow'])
+        self.assertEqual(value,15)
+        self.assertEqual(proof['printed_unit'],'$ millions')
+        self.assertFalse(proof['ISO_currency_inferred'])
+        self.assertIsNone(current['currency_symbol_proof']['currency'])
+        self.assertFalse(current['is_numeric_operand'])
+
+    def test_missing_lower_or_upper_anchor_abstains(self):
+        for old,new in [(b'$100',b'100'),(b'$140',b'140')]:
+            row=inspect(RAW.replace(old,new))
+            self.assertNotIn('currency_symbol_proof',row)
+            with self.assertRaises(ValueError):reproduce(row,inspect(year='2024'),['First flow'])
+
+    def test_qualified_mixed_hidden_symbols_abstain(self):
+        for replacement in [b'C$100',b'US$100',b'\xe2\x82\xac100',b'<span hidden>$100</span>']:
+            with self.subTest(replacement=replacement):
+                self.assertNotIn('currency_symbol_proof',inspect(RAW.replace(b'$100',replacement)))
+
+    def test_other_column_lacking_anchor_prevents_paired_calculation(self):
+        changed=RAW.replace(b'$90',b'GBP90')
+        current,prior=inspect(changed),inspect(changed,year='2024')
+        self.assertNotIn('currency_symbol_proof',prior)
+        with self.assertRaises(ValueError):reproduce(current,prior,['First flow'])
+
+    def test_row_locator_direction_and_issuer_are_immutable(self):
+        current,prior=inspect(),inspect(year='2024')
+        bad=copy.deepcopy(prior)
+        bad['source_grid']['cells'][0]['row_locator']='/wrong/row'
+        for left,right in [(current,bad),(prior,current),(current,{**prior,'entity':'OTHER'})]:
+            with self.assertRaises(ValueError):reproduce(left,right,['First flow'])
+
+    def test_unit_exception_and_empty_symbols_do_not_become_dollars(self):
+        for changed in [RAW.replace(b'In millions',b'In millions except per share'),RAW.replace(b'$',b'')]:
+            try:
+                row=inspect(changed)
+            except ValueError:
+                continue
+            self.assertNotIn('currency_symbol_proof',row)
+
+    def test_intervening_share_count_or_text_unit_rejects_entire_symbol_band(self):
+        for row in [b'<tr><td>Number of shares</td><td>25</td><td>24</td></tr>',
+                    b'<tr><td>Canadian dollars</td><td></td><td></td></tr>',
+                    b'<tr><td>Percentage</td><td>25</td><td>24</td></tr>']:
+            changed=RAW.replace(b'<tr><td>Second flow',row+b'<tr><td>Second flow')
+            with self.subTest(row=row):
+                self.assertNotIn('currency_symbol_proof',inspect(changed))
+
+    def test_other_statement_type_does_not_inherit_currency_from_anchors(self):
+        self.assertNotIn('currency_symbol_proof',inspect(RAW.replace(b'Cash flows',b'Operating statistics')))
