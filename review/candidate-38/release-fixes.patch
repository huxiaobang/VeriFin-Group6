+                       operand_ids=[previous["id"], previous["id"]], operand_versions={previous["id"]: 1})
+            records[row["id"]] = row
+            previous = row
+        with self.assertRaisesRegex(DataError, "too large"):
+            fraction_comparison(previous, previous, records)
