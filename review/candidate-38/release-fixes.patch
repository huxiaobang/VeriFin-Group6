+from verifin.tools import ToolRegistry
+from tests.test_segment_rate_spread import OriginalFixtureData
+
+class LegacySourceTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.store = SessionStore(Path(self.temp.name) / "session.sqlite")
+        self.sid = self.store.create_session()["id"]
+        self.tools = object.__new__(ToolRegistry)
+        self.tools.store = self.store
+        self.tools.data = OriginalFixtureData()
+        self.tools._percentage_index = {}
+        self.tools.data.raw_bytes = ("<table><tr><td></td><td>Three Months Ended</td></tr>"
+                                     "<tr><td></td><td>June 30, 2025</td></tr>"
+                                     "<tr><td>Operating income margin</td><td>12%</td></tr><tr><td>Other margin</td><td>9%</td></tr></table>").encode()
+        self.tools.data.digest = hashlib.sha256(self.tools.data.raw_bytes).hexdigest()
+        self.cell = self.tools.data.cells()[0]
+        self.store.put_evidence(self.sid, self.cell)
+    def tearDown(self):
+        self.store.close()
+        self.temp.cleanup()
+    def test_unchanged_source_is_noop_even_on_repeated_turn(self):
+        before = self.store.get_context(self.sid, report_mode="none")["evidence"]
+        self.assertEqual(self.tools.revalidate_saved_sources(self.sid), [])
+        self.assertEqual(self.tools.revalidate_saved_sources(self.sid), [])
+        self.assertEqual(self.store.get_context(self.sid, report_mode="none")["evidence"], before)
+    def test_bad_saved_cell_cascades_without_changing_value_or_identifier(self):
+        bad = self.store.put_evidence(self.sid, {**self.cell, "value": 99})
+        calc = {"id":"derived", "operation":"difference", "operand_ids":[bad["id"]], "value":27,
+                "unit":"percentage_points", "formula":"99 - 72 = 27", "scale":1, "entity":"EXAMPLE"}
+        self.store.put_calculation(self.sid, calc)
+        self.store.put_calculation(self.sid, {**calc, "id":"dependent", "operand_ids":["derived"]})
+        self.store.put_claim(self.sid, {"id":"oldclaim", "text":"Old computed result.", "calculation_ids":["dependent"]})
+        self.store.save_report(self.sid, {"request":"old", "claims":[{"text":"Archived 27 pp"}]})
+        archive = self.store.get_report(self.sid,1)
+        self.tools.revalidate_saved_sources(self.sid)
+        self.assertEqual(self.store.get_report(self.sid,1), archive)
+        ctx = self.store.get_context(self.sid, report_mode="none")
+        self.assertTrue(all(r["stale"] for r in ctx["evidence"] + ctx["calculations"] + ctx["claims"]))
+        self.assertEqual(ctx["evidence"][0]["id"], bad["id"])
+        self.assertEqual(ctx["evidence"][0]["value"],99)
+        self.assertEqual(len(self.store.history(self.sid,"evidence",bad["id"])),2)
+        self.store.put_evidence(self.sid, self.cell)
+        self.assertFalse(self.store.get_context(self.sid,report_mode="none")["evidence"][0]["stale"])
+        self.assertTrue(all(r["stale"] for r in self.store.get_context(self.sid,report_mode="none")["calculations"]))
