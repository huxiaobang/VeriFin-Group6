+    cells = []
+    for row in headers:
+        for column, cell in row:
+            if cell['source_row'] > max(group['source_row'], year['source_row']):
+                continue
+            text = cell['text']
+            covers_column = column <= left and right <= column + cell['colspan']
+            shared_caption = (cell['source_row'] == group['source_row'] and column == 0
