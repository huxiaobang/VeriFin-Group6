+"""A narrow explicit-arithmetic fallback plus declared numeric-origin boundary.
+
+This is not a language classifier for every derived prose sentence. New role
+outputs declare origin; legacy direct transcriptions remain compatible. A
+source-printed expression is still a source report, subject to Critic's scope
+review, rather than automatically a new calculation.
+"""
+from decimal import Decimal
+import re
+
+ABSOLUTE = r'(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?'
+NUMBER = r'(?:\([−-]'+ABSOLUTE+r'\)|[+−-]?'+ABSOLUTE+r')'
+EXPRESSION = re.compile(r'(?<![\w.,])(?P<a>'+NUMBER+r')\s*(?P<op>[+−-])\s*(?P<b>'+NUMBER+r')\s*=\s*(?P<c>'+NUMBER+r')(?!\w|\.\d|,\d)')
+
+
+def decimal(value):
+    value = value.replace(',', '').replace('−', '-')
+    if value.startswith('(') and value.endswith(')'):
+        value = value[1:-1]
+    return Decimal(value)
+
+
+def expressions(text):
+    if not isinstance(text, str):
+        return []
+    return [(decimal(match['a']), '-' if match['op'] in {'−', '-'} else '+',
+             decimal(match['b']), decimal(match['c'])) for match in EXPRESSION.finditer(text or '')]
+
+
+
+def row_result_bound(expression, calculations):
+    """Match this bounded operation's source sums, or disjoint calculated groups."""
+    a, op, b, c = expression
+    outputs = [row for row in calculations if Decimal(str(row['value'])) == c]
+    for output in outputs:
+        proof = output['source_row_change_proof']
+        if (op == '-' and Decimal(proof['current_sum_decimal']) == a
+                and Decimal(proof['prior_sum_decimal']) == b):
+            return True
+        # A bridge can also combine two independently calculated, disjoint row
+        # groups. Do not license a result from an unrelated group or period.
+        signed_b = -b if op == '-' else b
+        left = [row for row in calculations if Decimal(str(row['value'])) == a]
+        right = [row for row in calculations if Decimal(str(row['value'])) == signed_b]
+        for first in left:
+            for second in right:
+                first_rows = set(first['source_row_change_proof']['row_labels'])
+                second_rows = set(second['source_row_change_proof']['row_labels'])
+                if (not first_rows.intersection(second_rows)
+                        and first_rows.union(second_rows) == set(proof['row_labels'])
+                        and first['operand_ids'] == second['operand_ids'] == output['operand_ids']):
+                    return True
+    return False
+
+def defects(claim, records):
+    actual = expressions(claim.get('text', ''))
+    if not actual and claim.get('numeric_origin') != 'derived':
+        return []
+    def refs(name):
+        value = claim.get(name, [])
+        return value if isinstance(value, list) and all(isinstance(key, str) for key in value) else []
+    printed = {item for key in refs('evidence_ids') if key in records and records[key].get('kind') == 'document'
+               for field in ('text', 'quote') for item in expressions(records[key].get(field))}
+    derived = [item for item in actual if item not in printed]
+    if not derived and claim.get('numeric_origin') != 'derived':
+        return []
+    result = []
+    for a, op, b, c in derived:
+        if (a - b if op == '-' else a + b) != c:
+            result.append(('numerical_inconsistency', 'A newly derived arithmetic expression is internally inconsistent.'))
+    if not refs('calculation_ids'):
+        result.append(('missing_provenance', 'The newly derived value has no saved calculation result. Original table transcriptions remain separately reviewable.'))
+    source_rows = []
+    from .source_row_change import validate_record
+    for key in refs('calculation_ids'):
+        if key in records and records[key].get('operation') == 'source_row_group_change':
+            try:
+                validate_record(records[key], records)
+            except (ValueError, KeyError, TypeError, ArithmeticError):
+                continue  # Dependency validation independently reports this invalid record.
+            source_rows.append(records[key])
+    constraints = claim.get('constraints') if isinstance(claim.get('constraints'), dict) else {}
+    unit = claim.get('asserted_unit') or constraints.get('unit')
+    if derived and source_rows and isinstance(unit, str) and all(row.get('unit', '').casefold() == unit.casefold() for row in source_rows):
