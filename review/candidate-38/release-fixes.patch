+"""Source-bound arithmetic over two revalidated original row-inspection records.
+
+An inspection remains non-numeric for the ordinary calculator. This operation
+explicitly consumes its printed-number fields; selected row groups and their
+business meaning remain the caller's intent and Critic's responsibility.
+"""
+from datetime import date
+from decimal import Decimal
+import re
+from .data import stable_id
+from .statement_row_audit import json_numeric_value
+
+OPERATION = 'source_row_group_change'
+UNIT = re.compile(r'\b(Thousands|Millions|Billions) of Dollars\b', re.I)
+
+
+def reproduce(current, prior, labels):
+    if (not isinstance(labels, list) or not labels or len(labels) > 10
+            or any(not isinstance(label, str) or not label for label in labels)
+            or len(set(labels)) != len(labels)):
+        raise ValueError('Choose distinct exact printed row labels')
+    for row in (current, prior):
+        if (row.get('record_type') != 'original_statement_row_audit' or row.get('stale')
+                or row.get('is_numeric_operand') is not False or row.get('is_saved_calculation') is not False):
+            raise ValueError('Use two current original row-inspection records, not prose or derived values')
+    fields = ('entity', 'document_id', 'snapshot_hash', 'snapshot_path', 'source_url')
+    if any(current.get(key) != prior.get(key) for key in fields):
+        raise ValueError('Select two columns from the same registered original issuer and revision')
+    left, right = current['source_grid'], prior['source_grid']
+    if (left['table_id'] != right['table_id'] or left['group_locator'] != right['group_locator']
+            or left['year_locator'] == right['year_locator']):
+        raise ValueError('Select distinct year columns in the same original table and period group')
+    start, end = date.fromisoformat(current['period_start']), date.fromisoformat(current['period_end'])
+    old_start, old_end = date.fromisoformat(prior['period_start']), date.fromisoformat(prior['period_end'])
+    if (start.year != old_start.year + 1 or end.year != old_end.year + 1
+            or (start.month, start.day, end.month, end.day) != (old_start.month, old_start.day, old_end.month, old_end.day)
+            or not end > old_end):
+        raise ValueError('Year-over-year row change requires current then prior comparable source periods')
+    units = [row['unit_heading'] for row in (current, prior)]
+    if (units[0] != units[1] or re.search(r'except|per share|percent|%', units[0]['text'], re.I)):
+        raise ValueError('Use one explicit shared printed scale with no metric-specific unit exceptions')
+    unit = UNIT.search(units[0]['text'])
+    literal = False
+    if unit is None:
+        proofs = [r.get('currency_symbol_proof') for r in (current, prior)]
+        if not all(isinstance(p, dict) and p.get('schema') == 'literal-dollar-row-band-v1'
+                   and p.get('symbol') == '$' and p.get('currency') is None
+                   and p.get('ISO_currency_inferred') is False for p in proofs):
+            raise ValueError('An explicit printed dollar scale or revalidated same-table symbol proof is required')
+        for row, proof in zip((current,prior),proofs):
+            grid = row['source_grid']
+            if (proof['table_locator'] != grid['table_locator'] or proof['group_locator'] != grid['group_locator']
+                    or proof['year_locator'] != grid['year_locator'] or proof['column_interval'] != grid['common_header_interval']
+                    or proof['selected_cell_locators'] != [c['locator'] for c in grid['cells']]
+                    or proof['scale_locator'] != row['unit_heading']['locator'] or proof['scale'] != row['unit_heading']['scale']):
+                raise ValueError('Currency witness and selected source rows disagree')
+        unit = re.search(r'\b(thousands|millions|billions)\b', units[0]['text'], re.I)
+        literal = True
+
+    if unit is None or units[0].get('currency') is not None:
+        raise ValueError('An explicit printed dollar scale is required; ISO currency is not inferred')
+    expected_scale = {'thousands':1000,'millions':1000000,'billions':1000000000}[unit[1].lower()]
+    if type(units[0].get('scale')) is not int or units[0]['scale'] != expected_scale:
+        raise ValueError('Printed scale and source unit heading disagree')
+    cells = []
+    for grid in (left, right):
+        indexed = {cell['row_label']: cell for cell in grid['cells']}
+        if len(indexed) != len(grid['cells']) or any(label not in indexed for label in labels):
+            raise ValueError('Selected rows must occur once in each inspected column')
+        selected = [indexed[label] for label in labels]
+        for cell in selected:
+            if not Decimal(cell['printed_decimal']).is_finite():
+                raise ValueError('Printed source number must be finite')
+            if (cell.get('value_origin') != 'printed_original_cell'
+                    or type(cell.get('printed_numeric_value')) not in (int, float)
+                    or Decimal(str(cell['printed_numeric_value'])) != Decimal(cell['printed_decimal'])):
+                raise ValueError('A selected printed source number has an inconsistent representation')
+        cells.append(selected)
+    if any(a['row_locator'] != b['row_locator'] for a, b in zip(*cells)):
+        raise ValueError('The two years must refer to the same physical source rows')
+    current_total = sum(Decimal(cell['printed_decimal']) for cell in cells[0])
+    prior_total = sum(Decimal(cell['printed_decimal']) for cell in cells[1])
+    return current_total - prior_total, {
+        'row_labels': labels, 'current_printed_values': [cell['printed_decimal'] for cell in cells[0]],
+        'prior_printed_values': [cell['printed_decimal'] for cell in cells[1]],
+        'current_cell_locators': [cell['locator'] for cell in cells[0]],
+        'prior_cell_locators': [cell['locator'] for cell in cells[1]],
+        'current_sum_decimal': str(current_total), 'prior_sum_decimal': str(prior_total),
