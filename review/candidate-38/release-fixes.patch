+class WebSourceModeTests(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory();self.db=Path(self.temp.name)/"db.sqlite"
+        self.data=Path(__file__).resolve().parents[1]/"data/replay"
+        with SessionStore(self.db) as store:self.sid=store.create_session()["id"]
+        self.open_web()
+    def open_web(self):
+        self.app=Application(self.db,self.data)
+        self.server=ThreadingHTTPServer(("127.0.0.1",0),handler_for(self.app))
+        self.thread=threading.Thread(target=self.server.serve_forever,daemon=True);self.thread.start()
+        self.url="http://127.0.0.1:"+str(self.server.server_port)
+    def close_web(self):
+        self.server.shutdown();self.server.server_close();self.thread.join(2)
+    def restart_web(self):self.close_web();self.open_web()
+    def tearDown(self):self.close_web();self.temp.cleanup()
+    def request(self,body=None,path=None):
+        path=path or "/api/session/"+self.sid+"/ask"
+        request=Request(self.url+path,data=json.dumps(body).encode() if body is not None else None,
+                        headers={"X-VeriFin-Token":self.app.token})
+        try:response=urlopen(request,timeout=3)
+        except HTTPError as error:response=error
+        with response:
+            raw=response.read();return response.status,json.loads(raw) if response.headers.get_content_type()=="application/json" else raw.decode()
+    def wait(self,rid):
+        for attempt in range(200):
+            status,row=self.request(path="/api/session/"+self.sid+"?request_id="+rid)
+            if not row["running"] and row["requested_submission"]["status"] not in {"pending","running"}:return row
+            time.sleep(.01)
+        self.fail("worker did not finish")
+    def cli(self,args,model):
+        with patch("verifin.cli.ModelClient.from_env",return_value=model),patch("verifin.cli.ToolRegistry",return_value=MixedTools()),contextlib.redirect_stdout(io.StringIO()) as stdout,contextlib.redirect_stderr(io.StringIO()):
+            status=main(["--db",str(self.db),"--data-dir",str(self.data),*args])
+        return status,stdout.getvalue()
