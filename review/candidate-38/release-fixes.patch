+    if any(row.get(field) != value for field, value in original.items()):
+        raise DataError('Reconciliation operand differs from original value, unit, issuer, period, role or table witness.')
+    return original
+
+
+def validate_pair(a, b, data):
+    proof = dimensions(a, b)
+    cache = {}
+    for row in (a, b):
+        revalidate(row, data, cache)
+    return proof
