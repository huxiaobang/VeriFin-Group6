+"""Conservative physical-column decoding of explicitly dated segment margin tables."""
+import re
+from decimal import Decimal
+from .data import stable_id
+
+MONTH_DAY = re.compile(r"(?:January|February|March|April|May|June|July|August|September|October|November|December)\s+\d{1,2},?", re.I)
+
+
+def extract(table, document, rows):
+    from .table_cells import DURATION, PERCENT, column_period
+    duration = month_day = None
+    years = {}
+    scope = None
+    metric_header = None
+    result = []
+    for row in rows:
+        nonempty = [(col, cell) for col, cell in row if cell['text'].strip()]
+        if not nonempty:
+            continue
+        if len(nonempty) == 1 and DURATION.fullmatch(nonempty[0][1]['text']):
+            duration = nonempty[0][1]
+            month_day, years, scope, metric_header = None, {}, None, None
+            continue
+        if len(nonempty) == 1 and MONTH_DAY.fullmatch(nonempty[0][1]['text']):
+            month_day = nonempty[0][1]
+            continue
+        if all(re.fullmatch(r'(?:19|20)\d\d', cell['text']) for _, cell in nonempty):
+            years = {}
+            for col, cell in nonempty:
+                for position in range(col, col + cell['colspan']):
+                    years[position] = cell
+            scope = metric_header = None
+            continue
+        margins = [(col, cell) for col, cell in nonempty if cell['text'].casefold() == 'operating margin']
+        if margins:
+            first_col, first = nonempty[0]
+            if len(margins) != 1 or first_col != 0 or first is margins[0][1] or first['colspan'] != 1:
+                scope = metric_header = None
+                continue
+            scope, metric_header = first, margins[0]
+            continue
+        label = nonempty[0][1]
+        basis = {'gaap':'GAAP', 'non-gaap adjusted measure':'issuer_defined_non_GAAP'}.get(label['text'].casefold())
+        if not (duration and month_day and years and scope and metric_header and basis and nonempty[0][0] == 0):
+            continue
+        start_col, heading = metric_header
+        end_col = start_col + heading['colspan']
+        for index, (col, cell) in enumerate(row):
+            if not start_col <= col < end_col or cell['rowspan'] != 1 or cell['colspan'] != 1:
+                continue
+            hit = PERCENT.fullmatch(cell['text'])
+            parts = [cell]
+            if hit is None and index + 1 < len(row):
+                next_col, adjacent = row[index + 1]
+                if (next_col == col + 1 and next_col < end_col and adjacent['text'] in {'%', ')%'}
+                        and adjacent['rowspan'] == adjacent['colspan'] == 1
+                        and years.get(col) is years.get(next_col)):
+                    hit = PERCENT.fullmatch(cell['text'] + adjacent['text'])
+                    parts.append(adjacent)
+            if hit is None or col not in years:
+                continue
+            year = years[col]
+            period = column_period([duration['text'], month_day['text'].rstrip(',') + ', ' + year['text']])
+            if period is None:
+                continue
+            value = Decimal((hit['signed'] or hit['negative']).replace(',', '').replace('−', '-'))
+            if hit['negative']:
+                value = -value
+            source = {k: document[k] for k in ('entity','source_url','snapshot_hash','snapshot_path','published_at','mode')}
+            result.append({**source, 'id':stable_id('cell_', [table['id'],cell['dom_xpath']]),
+                'kind':'financial_fact', 'cell_type':'segment_percentage_cell', 'document_id':document['id'],
+                'table_id':table['id'], 'locator':cell['dom_xpath'],
+                'value':float(value), 'unit':'%', 'scale':1, 'currency':None,
+                'metric':'operating_income_margin', 'business_scope':scope['text'], 'basis':basis,
+                'period_start':period[0], 'period_end':period[1],
+                'row_label':scope['text'] + ' ' + label['text'] + ' ' + heading['text'],
+                'source_row_label':label['text'], 'metric_header':heading['text'],
+                'cell_text':' '.join(p['text'] for p in parts),
+                'cell_locators':[p['dom_xpath'] for p in parts],
+                'row_label_locator':label['dom_xpath'], 'business_scope_locator':scope['dom_xpath'],
+                'metric_header_locator':heading['dom_xpath'],
+                'column_headers':[duration['text'],month_day['text'],year['text']],
+                'column_header_locators':[duration['dom_xpath'],month_day['dom_xpath'],year['dom_xpath']],
+                'text':scope['text'] + ' | ' + label['text'] + ' | ' + heading['text'] + ' | ' +
+                       ' / '.join([duration['text'],month_day['text'],year['text']]) + ' | ' + ' '.join(p['text'] for p in parts)})
+    return result
