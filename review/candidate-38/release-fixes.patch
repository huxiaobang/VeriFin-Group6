+    if type(value) not in (int, float):
+        raise DataError("Ratio definitions require finite numerical records.")
+    number = Decimal(str(value))
+    if not number.is_finite():
+        raise DataError("Ratio definitions require finite numerical records.")
+    return number
+
+
