+"""Identify a registered issuer original without equating its author with its host.
+
+An EX-99 label alone is insufficient. The registry must already attest an original
+release, its original header must identify financial results, and a SEC copy must
+belong to this exact registered issuer's accession path.
+"""
+import re
+from datetime import date
+from urllib.parse import urlsplit
+from .data import DataError
+
+
+ORIGINAL = re.compile(r"\boriginal\s+(?:(?:earnings|press|news)\s+)?release\s+(?:dateline|publication)\b", re.I)
+MARKER = re.compile(r"\b(?:Exhibit\s+99(?:\.\d+)?|(?:News|Press|Earnings)\s+Release)\b", re.I)
+RESULTS = re.compile(r"\b(?:reports?|announces?)\b[^\n•–—]{0,160}\b(?:financial\s+)?results\b", re.I)
+
+
+def _dated_headline(raw, text, document, company, resolve_issuer):
+    """Use separate visible title and dated issuer self-attribution in the original introduction."""
+    try:
+        from lxml import etree, html
+    except ImportError:
+        return None
+    from .structured_documents import _hidden
+    try:
+        day = date.fromisoformat(document["published_at"][:10])
+        tree = html.fromstring(raw[:65536], parser=html.HTMLParser(encoding="utf-8", no_network=True))
+    except (ValueError, KeyError, TypeError, etree.ParserError):
+        return None
+    prefix = " ".join(text[:3400].split())
+    for node in list(tree.iterdescendants()):
+        if isinstance(node.tag, str) and _hidden(node) and node.getparent() is not None:
+            node.drop_tree()
+    blocks = tree.xpath("//*[self::div or self::p or self::h1 or self::h2 or self::h3]"
+                        "[not(ancestor::table)][not(.//div or .//p or .//table)]")
+    for index, block in enumerate(blocks[:30]):
+        heading = " ".join(block.text_content().split())
+        if not heading or len(heading) > 225 or heading not in prefix:
+            continue
+        match = re.fullmatch(r"(.{1,70}?)\s+(?:reports|announces)\s+(.+)", heading, re.I)
+        if not match or not re.search(r"\b(?:quarter|Q[1-4])\b", match[2], re.I) or not re.search(
+                r"\b(?:earnings|results|revenue)\b", match[2], re.I):
+            continue
+        subject = match[1]
+        if subject.casefold() not in {company["name"].casefold(), company["ticker"].casefold(),
+                                      *(alias.casefold() for alias in company.get("aliases", []))}:
+            if resolve_issuer is None:
+                return None
+            try:
+                resolved = resolve_issuer(subject)
+            except DataError:
+                return None
+            if (resolved.get("ticker") != company["ticker"] or
+                    str(resolved.get("cik", "")).lstrip("0") != str(company["cik"]).lstrip("0")):
+                return None
+        # Bind the title's author to an exchange ticker and publication date in
+        # the separate dateline. A nearby contact, filename or peer mention is insufficient.
+        stamp = re.escape(day.strftime("%B")) + rf"\s+0?{day.day},\s*{day.year}"
+        attribution = (stamp + r"\s*[-–—]+\s*" + re.escape(subject)
+                       + r"\s*(?:\(the [\"“]Company[\"”]\)\s*)?\((?:NYSE|NASDAQ)\s*:\s*"
+                       + re.escape(company["ticker"])
+                       + r"\)[^.•]{0,160}?\btoday (?:reported|announced)\b[^.•]{0,85}?\b(?:results|earnings)\b")
+        dateline = re.search(attribution, prefix.split(heading, 1)[1], re.I)
+        if dateline:
+            supporting = [node for node in blocks[index+1:index+45]
+                          if dateline[0].casefold() in " ".join(" ".join(node.itertext()).split()).casefold()]
+            if len(supporting) == 1:
+                return heading, subject, {"original_title_xpath": tree.getroottree().getpath(block),
+                                          "original_dateline_xpath": tree.getroottree().getpath(supporting[0]),
+                                          "original_dateline_attribution": dateline[0]}
+        return None
+    return None
+
+
+def original_release(data, document, company, resolve_issuer=None):
+    if document.get("entity") != company.get("ticker"):
+        return None
+    if document.get("publisher_entity") not in (None, document["entity"]):
+        return None
+    if document.get("publisher_kind") not in (None, "issuer"):
+        return None
+    basis = document.get("publication_basis") or ""
+    if not ORIGINAL.search(basis):
+        return None
+    info = data.info(document["source"])
+    url = urlsplit(info["url"])
+    if (url.scheme not in ("http", "https") or (url.hostname or "").lower() not in ("sec.gov", "www.sec.gov")
+            or url.username is not None or url.password is not None):
+        return None
+    accession = re.fullmatch(r"/Archives/edgar/data/(\d{1,10})/\d{18}/[^/]+", url.path)
+    cik = str(company.get("cik") or "")
+    if not accession or not cik.isdigit() or int(accession[1]) != int(cik):
+        return None
+    raw = data.raw(document["source"])
+    registered_form = document.get("form") or ""
+    exhibit = re.search(r"\bEX[- ]?99(?:\.\d+)?\b", registered_form, re.I)
+    if exhibit is None:
+        header = re.search(rb"<TYPE>\s*(EX-99(?:\.\d+)?)\b", raw[:4096], re.I)
+        if header is None:
+            return None
+        exhibit_text = header[1].decode("ascii")
+    else:
+        exhibit_text = exhibit[0]
+    text = data.raw(document["text"]).decode("utf-8")
+    # Only the source's introductory release header is used for document type;
+    # filenames, arbitrary later tables and financial amounts cannot supply it.
+    prefix = text[:2000]
+    matches = []
+    for marker in MARKER.finditer(prefix):
+        after = prefix[marker.end():marker.end()+220]
+        if result := RESULTS.search(after):
+            subject = after[:result.start()].strip(" \t\r\n:–—-")
+            # A nested News/Press Release marker is not the publisher.
+            # Let that later marker identify its own headline subject.
+            if not subject or MARKER.search(subject):
+                continue
+            known_names = [company.get("name"), company.get("ticker"), *company.get("aliases", [])]
+            resolved = company if any(subject.casefold() == name.casefold() for name in known_names if name) else None
+            if resolved is None and resolve_issuer is not None:
+                try:
+                    resolved = resolve_issuer(subject)
+                except DataError:
+                    continue
+            if (not resolved or resolved.get("ticker") != company.get("ticker")
