+import unittest
+from verifin.skill_routing import issuer_decision_conflict, resolve_issuer_scope, user_issuer_boundary
+
+
+class ComparisonFollowupTests(unittest.TestCase):
+    catalog = [{"ticker": t, "name": n} for t, n in
+               [("AAA", "Alpha Inc"), ("BBB", "Beta Inc"), ("CCC", "Gamma Inc")]]
+
+    def test_one_old_one_new_and_definite_pair(self):
+        message = "What about Beta Inc? Which company was higher? Link both companies' filings."
+        names, single = resolve_issuer_scope(message, [], {"entities": ["AAA"]}, self.catalog)
+        self.assertEqual((names, single), (["AAA", "BBB"], None))
+        guard = user_issuer_boundary(message, ["BBB"], names, ["AAA"])
+        self.assertIsNone(issuer_decision_conflict(guard, {"scope": {"entities": names}}, self.catalog))
+        self.assertIsNotNone(issuer_decision_conflict(guard, {"scope": {"entities": names + ["CCC"]}}, self.catalog))
+
+    def test_plain_switch_and_open_peer_do_not_import_previous_company(self):
+        for message in ("What about Beta Inc?", "Beta Inc and a competitor: compare both companies.",
+                        "Beta Inc 去年收购两家企业，收入多少？"):
+            with self.subTest(message=message):
+                names, _ = resolve_issuer_scope(message, [], {"entities": ["AAA"]}, self.catalog)
+                self.assertEqual(names, ["BBB"])
