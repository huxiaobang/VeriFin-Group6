+"""Document authorship is independent of its archival host; provenance is required."""
+import unittest
+from verifin.issuer_release_metadata import original_release
+from verifin.source_scope import bound_context, bound_decision, source_constraint, tool_allowed
+
+
+class RegisteredOriginal:
+    url = 'https://www.sec.gov/Archives/edgar/data/123/000000012325000001/exhibit.htm'
+    raw_source = b'<TYPE>EX-99.1\n<html>issuer release</html>'
+    text = b'Exhibit 99.1 News Release Example Incorporated Reports Second-Quarter 2025 Results'
+
+    def info(self, source):
+        return {'url': self.url, 'sha256': 'verified-original-hash'}
+
+    def raw(self, source):
+        return self.raw_source if source == 'original' else self.text
+
+
+class IssuerReleaseMetadataTests(unittest.TestCase):
+    def setUp(self):
+        self.data = RegisteredOriginal()
+        self.document = {'entity': 'EXM', 'source': 'original', 'text': 'text',
+                         'publication_basis': 'Dated original release dateline'}
+        self.company = {'ticker': 'EXM', 'cik': '0000000123', 'name': 'Example Incorporated'}
+
+    def proof(self):
+        return original_release(self.data, self.document, self.company)
+
+    def test_original_type_and_same_issuer_accession_are_required(self):
+        proof = self.proof()
+        self.assertEqual(proof['kind'], 'issuer_earnings_release')
+        self.assertIn('Reports', proof['type_evidence']['original_header'])
+
+    def test_exhibit_label_alone_is_insufficient(self):
+        for field in ('basis', 'headline', 'form', 'cik', 'publisher', 'entity'):
+            with self.subTest(field=field):
+                self.setUp()
+                if field == 'basis':
+                    self.document.pop('publication_basis')
+                elif field == 'headline':
+                    self.data.text = b'Exhibit 99.1 Agreement and financial information'
+                elif field == 'form':
+                    self.data.raw_source = b'<TYPE>EX-10.1'
+                elif field == 'cik':
+                    self.company['cik'] = '456'
+                elif field == 'publisher':
+                    self.document['publisher_kind'] = 'third_party'
+                else:
+                    self.document['publisher_entity'] = 'OTHER'
+                self.assertIsNone(self.proof())
+
+    def test_missing_publisher_is_not_resolved_from_an_empty_query(self):
+        self.data.text = b'Exhibit 99.1 News Release Reports Second-Quarter Results'
+        self.assertIsNone(original_release(self.data, self.document, self.company, lambda subject: self.company))
+
+    def test_same_accession_third_party_release_is_not_issuer_authored(self):
+        self.data.text = b'Exhibit 99.1 News Release Other Issuer Reports Second-Quarter 2025 Results'
+        self.assertIsNone(self.proof())
+
+    def test_ambiguous_or_wrong_header_publisher_resolution_abstains(self):
+        from verifin.data import DataError
+        self.data.text = b'Exhibit 99.1 News Release Example Reports Results'
+        def ambiguous(subject):
+            raise DataError('Ambiguous registered identity')
+        self.assertIsNone(original_release(self.data, self.document, self.company, ambiguous))
+        other = {'ticker': 'OTHER', 'cik': '456', 'name': 'Example Holdings'}
+        self.assertIsNone(original_release(self.data, self.document, self.company, lambda subject: other))
+        same = original_release(self.data, self.document, self.company, lambda subject: self.company)
+        self.assertEqual(same['publisher_evidence']['original_headline_publisher'], 'Example')
+
+    def test_filename_and_late_body_do_not_supply_release_header(self):
+        self.data.text = b'EX-99.1 reports-results.htm Agreement ' + b'x'*2000 + b' News Release Example Incorporated Reports Results'
+        self.assertIsNone(self.proof())
+
+    def context(self, request):
+        row = {'document_id': 'registered-doc', 'entity': 'EXM', 'source_url': self.data.url,
+               'snapshot_hash': 'verified-original-hash', 'issuer_release_provenance': self.proof()}
+        ctx = {'episode': {'request': request}, 'scope': {'entities': ['EXM']}, 'reports': [],
+               'evidence': [{**row, 'id': 'good'}, {**row, 'id': 'bad', 'snapshot_hash': 'wrong'}],
+               'calculations': [], 'tools': [{'name': 'search_documents'}, {'name': 'financial_facts'}]}
+        return bound_context(ctx, catalog=[row], companies=[self.company])
+
+    def test_release_only_does_not_imply_no_sec_host(self):
+        request = 'Using only Example’s second-quarter 2025 earnings release, give the pre-tax reconciliation.'
+        policy = source_constraint(request)
+        self.assertTrue(policy.release_only)
+        self.assertIsNone(policy.publisher)
+        self.assertFalse(policy.permits_auto_sec)
+        ctx = self.context(request)
+        self.assertEqual(ctx['source_document_scope']['document_ids'], ['registered-doc'])
+        self.assertEqual([r['id'] for r in ctx['evidence']], ['good'])
+        decision = bound_decision(ctx, {'action': 'tool', 'tool': 'search_documents', 'arguments': {}})
+        self.assertEqual(decision['arguments']['document_ids'], ['registered-doc'])
+
+    def test_explicit_host_exclusions_survive_release_proof(self):
+        for request in ("Use only the issuer's investor relations site earnings release.",
+                        'Use only the earnings release. Do not consult SEC.'):
+            with self.subTest(request=request):
+                self.assertEqual(self.context(request)['source_document_scope']['document_ids'], [])
+
+    def test_sec_release_does_not_admit_other_sec_datasets(self):
+        ctx = self.context('Use only the SEC-hosted earnings release.')
+        self.assertTrue(ctx['source_document_scope']['release_only'])
+        self.assertFalse(tool_allowed('sec', 'financial_facts', True))
+        self.assertFalse(source_constraint('Use only the SEC-hosted earnings release.').permits_auto_sec)
+        self.assertTrue(tool_allowed('sec', 'financial_facts', False))
+
+    def test_missing_original_has_english_clarification(self):
+        ctx = self.context("Use only the issuer's investor relations site earnings release.")
+        result = bound_decision(ctx, {'action': 'tool', 'tool': 'search_documents', 'arguments': {}})
+        self.assertEqual(result['action'], 'clarify')
+        self.assertIn('No registered original', result['question'])
+
+
+class CatalogReadBoundaryTests(unittest.TestCase):
+    def test_only_explicit_published_issuer_release_classification_reads_bodies(self):
+        import tempfile
+        from pathlib import Path
+        from unittest.mock import patch
+        from verifin.tools import ToolRegistry
