+
+
+def report(entities=("ORBT","HARB")):
+    first="Northstar reported order backlog of $12 million as of March 31, 2025. Original: https://example.test/one"
+    second="Southstar reported order backlog of $8 billion as of April 30, 2025. Original: https://example.test/two"
+    claims=[];records=[]
+    for index,(entity,text) in enumerate(zip(entities,(first,second))):
+        cid,ref=("a","ea") if index==0 else ("b","eb")
+        claims.append({"id":cid,"text":text,"version":2,"scope_version":1,"status":"Supported","constraints":{"entity":entity},
+            "requirement_ids":["joint"],"evidence_ids":[ref],"evidence_versions":{ref:1},"calculation_ids":[],
+            "critic_verdict":{"claim_id":cid,"status":"Supported","evidence_refs":[ref],"basis":"Reviewed source."}})
+        records.append({"id":ref,"version":1,"entity":entity,"text":text,"source_url":"https://example.test/"+ref})
+    parts={"one":"What amount did each issuer report?","two":"Give each as-of date, its printed units and the two originals."}
+    return {"status":"complete","verification_available":True,"scope_version":1,"model_mode":"offline_test",
+        "scope":{"entities":list(entities),"requirements":[{"id":"joint","text":"Report both issuers with dates, units and original citations."}]},
+        "claims":claims,"evidence":records,"calculations":[],"request_parts":parts,
+        "record_versions":{"claim":{"a":2,"b":2},"evidence":{"ea":1,"eb":1},"calculation":{}},
+        "request_coverage":[{"part":"one","status":"answered","claim_id":"a","answer_sentence":first,"supporting_claim_ids":["a","b"]},
+                            {"part":"two","status":"answered","claim_id":"b","answer_sentence":second,"supporting_claim_ids":["a","b"]}]}
+
+
+class MultiEntityCardTests(unittest.TestCase):
+    def test_other_issuer_is_a_direct_answer_not_redundant_supplement(self):
+        for entities in [("ORBT","HARB"),("A1","B2"),("甲","乙")]:
+            with self.subTest(entities=entities):
+                value=report(entities);view=report_view(value)
+                self.assertEqual(len(view["answer_sections"]),2)
+                for row in view["answer_sections"]:
+                    self.assertEqual({cid for f in row["answer_fragments"] for cid in f["claim_ids"]},{"a","b"})
+                    self.assertIn("March 31, 2025",row["answer_text"])
+                    self.assertIn("April 30, 2025",row["answer_text"])
+                text=render_markdown(value).split("**Give each as-of date")[1]
+                self.assertIn("Northstar",text);self.assertIn("Southstar",text)
+    def test_unmapped_foreign_claim_is_not_added(self):
+        value=report();value["request_coverage"][1]["supporting_claim_ids"]=["b"]
+        row=report_view(value)["answer_sections"][1]
+        self.assertNotIn("Northstar",row.get("answer_text",row.get("answer_sentence","")))
+    def test_other_question_specific_claim_is_not_mixed_even_if_reviewer_lists_it(self):
+        value=report();parts={"one":"What did Northstar report?","two":"What did Southstar report?"};value["request_parts"]=parts
+        value["scope"]["requirements"]=[{"id":"ra","text":parts["one"]},{"id":"rb","text":parts["two"]}]
+        value["claims"][0]["requirement_ids"]=["ra"];value["claims"][1]["requirement_ids"]=["rb"]
+        rows=report_view(value)["answer_sections"]
+        self.assertNotIn("Southstar",rows[0].get("answer_text",rows[0].get("answer_sentence","")))
+        self.assertNotIn("Northstar",rows[1].get("answer_text",rows[1].get("answer_sentence","")))
+    def test_unproven_foreign_claim_never_gets_added_as_a_fragment(self):
+        for defect in ["stale","unsupported","wrong_claim_version","wrong_source_version","wrong_receipt_id","missing_reference"]:
+            with self.subTest(defect=defect):
+                value=report();value["status"]="partial";claim=value["claims"][0]
+                if defect=="stale":claim["stale"]=True
+                elif defect=="unsupported":claim["status"]=claim["critic_verdict"]["status"]="Insufficient Evidence"
+                elif defect=="wrong_claim_version":claim["version"]=3
+                elif defect=="wrong_source_version":value["evidence"][0]["version"]=2
+                elif defect=="wrong_receipt_id":claim["critic_verdict"]["claim_id"]="unrelated"
+                else:claim["critic_verdict"]["evidence_refs"]=["missing"]
+                row=report_view(value)["answer_sections"][1]
+                self.assertNotIn("a",{cid for f in row.get("answer_fragments",[]) for cid in f["claim_ids"]})
+    def test_unverified_report_cannot_gain_an_answer_from_this_layout_change(self):
+        value=report();value["verification_available"]=False
+        self.assertFalse(any(row["status"]=="answered" for row in report_view(value)["answer_sections"]))
+
+    def test_normal_engine_rejects_a_wrong_issuer_source_without_borrowing_other_answer(self):
+        from pathlib import Path
+        import tempfile
+        from tests.test_engine import ScriptedModel,FixtureTools,FACT
+        from verifin.engine import ResearchEngine
+        from verifin.storage import SessionStore
+        value=report();parts={"one":"What did Northstar report?","two":"What did Southstar report?"}
+        requirements=[{"id":"ra","text":parts["one"]},{"id":"rb","text":parts["two"]}]
+        scope={"entities":["ORBT","HARB"],"cutoff":"2025-06-01","requirements":requirements}
+        facts=[{**FACT,"id":ref,"entity":entity,"metric":"backlog","period_start":None,"period_end":"2025-03-31","value":amount}
+               for ref,entity,amount in [("ea","ORBT",12000000),("eb","HARB",8000000000)]]
+        claims=[]
+        for index,claim in enumerate(value["claims"]):
+            claims.append({"id":claim["id"],"text":claim["text"],"requirement_ids":["ra" if index==0 else "rb"],
+                "evidence_ids":["ea"],"calculation_ids":[],"constraints":{"entity":"ORBT" if index==0 else "HARB"}})
+        research={"claims":claims,"summary":"Both companies.","answered_requirement_ids":["ra","rb"],"unanswered_requirement_ids":[]}
+        review={"issues":[],"reviewed_claim_ids":["a","b"],"reviewed_requirement_ids":["ra","rb"],"request_coverage":value["request_coverage"]}
+        script=[("planner",{"action":"tool","tool":"financial_facts","arguments":{"entity":"ORBT"},"scope":scope}),
+                ("planner",{"action":"research"}),("researcher",research),("critic",review),("planner",{"action":"finish"})]
+        tools=FixtureTools({"ok":True,"summary":"two explicit source fixtures","evidence":facts,"calculations":[],"data":{}})
+        with tempfile.TemporaryDirectory() as tmp,SessionStore(Path(tmp)/"db") as store:
+            model=ScriptedModel(script)
+            result=ResearchEngine(store,model,tools).ask(store.create_session()["id"]," ".join(parts.values()))
+        self.assertEqual(result["status"],"partial")
+        self.assertTrue(any(i["issue_type"]=="context_mismatch" for i in result["report"]["issues"]))
+        rows=report_view(result["report"])["answer_sections"]
+        self.assertFalse(any("Northstar" in row.get("answer_text",row.get("answer_sentence","")) for row in rows if "Southstar" in row["question"]))
+
+    def test_same_issuer_different_periods_keep_both_signed_amounts(self):
+        value=report(("ONE","ONE"));value["scope"]["entities"]=["ONE"]
+        texts=["Northstar reported cash outflow (17) million dollars for the 24 weeks ended June 13, 2026.",
+               "Northstar reported the prior-year cash outflow as (29) million dollars for the 24 weeks ended June 14, 2025."]
+        for claim,text,end in zip(value["claims"],texts,["2026-06-13","2025-06-14"]):
+            claim["text"]=text;claim["constraints"].update(metric="repurchases",period_end=end,unit="million dollars")
+        value["request_parts"]={"one":"How much cash was spent, and what is the prior-year comparison?",
+                                "two":"Give the signed statement amounts, units and period lengths."}
+        value["scope"]["requirements"]=[{"id":"joint","text":"Report both dated statement amounts and their signs, units and periods."}]
+        for row,cid in zip(value["request_coverage"],["a","b"]):
+            row.update(claim_id=cid,answer_sentence=value["claims"][0 if cid=="a" else 1]["text"])
+        view=report_view(value)
+        for row in view["answer_sections"]:
+            self.assertIn("(17)",row["answer_text"]);self.assertIn("(29)",row["answer_text"])
