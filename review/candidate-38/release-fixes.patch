+        with patch("verifin.webapp.threading.Thread",side_effect=thread),patch("verifin.webapp.ModelClient.from_env",return_value=ScriptedModel(selected_script())):
+            status,queued=self.request({"message":"Use only the 10-Q to report quarterly revenue.","as_of":"2025-02-01","request_id":rid,"source_selection":"semantic"})
