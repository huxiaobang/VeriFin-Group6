+            'ordered_cells': [{'id': row['id'], 'version': row['version'], 'role': row['reconciliation_role'],
+                               'locator': row['locator']} for row in (a, b)],
+            'currency_semantics': 'The same source dollar symbol cancels; no ISO currency conversion or identity is asserted.'}
+
