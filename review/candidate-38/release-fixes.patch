+"""Bind figures in an explicitly ordered, dated segment-margin disclosure."""
+from decimal import Decimal
+import re
+
+from .financial import duration_class
+from .table_cells import column_period
+
+
+NOTE = re.compile(
+    r"(?:^|[.;]\s+|\bnote\s*[-–:]\s*)"
+    r"(?P<basis>adjusted\s+|gaap\s+|reported\s+)?operating (?:profit |income )?margins? for "
+    r"(?P<names>[^.;:%\n]{1,360}?) (?:was|were) "
+    r"(?P<values>[-+\d.,%\sand]{3,180}),?\s+respectively,?\s+for (?:the )?"
+    r"(?P<period>(?:three|six|nine|twelve) months ended [a-z]+ \d{1,2},? \d{4})\b",
+    re.IGNORECASE,
+)
+RATE = re.compile(r"[+-]?\d+(?:\.\d+)?\s*%")
+
+
+def _members(text):
+    # The final conjunction must unambiguously separate two members.
+    head, sep, tail = text.strip().rstrip(",").rpartition(" and ")
+    if not sep or not tail or " and " in head:
+        return []
+    return [part.strip() for part in head.rstrip(",").split(",")] + [tail.strip()]
+
+
+def disclosed_rates(text):
+    rows = []
+    for match in NOTE.finditer(text):
+        names = _members(match["names"].casefold())
+        values = _members(match["values"].casefold())
+        period = column_period([match["period"]])
+        if (not period or len(values) < 2 or len(values) != len(names) or len(set(names)) != len(names)
+                or any(not name or len(name) > 90 for name in names)
+                or not all(RATE.fullmatch(value) for value in values)):
+            continue
+        basis = (match["basis"] or "reported").strip().casefold()
+        for name, value in zip(names, values):
+            rows.append((name, period, basis, Decimal(value.rstrip("%").strip())))
+    return rows
+
+
+def _period_matches(source_period, declared, assertion):
+    start, end = declared
+    if source_period[1] != end:
+        return False
+    if start is not None and source_period[0] != start:
+        return False
+    # Only an explicit assertion can distinguish a quarter from a half-year
+    # ending on the same day. Quoted source text can enumerate both periods.
+    lead = re.split(r'[.!?。！？“"]', assertion, maxsplit=1)[0]
+    quarter = re.search(r"\b(?:quarter(?:ly)?|q[1-4]|three months)\b", lead, re.I)
+    competing = re.search(r"\b(?:year.to.date|half.year|six months|nine months|annual|prior|previous|last quarter)\b", lead, re.I)
+    is_quarter = duration_class(*source_period) == "quarter_length"
+    if quarter and not competing and not is_quarter:
+        return False
+    if start is not None:
+        return True
+    return bool(quarter and not competing and is_quarter)
+
+
+def matches_note(citations, constraints, value, tolerance, assertion=""):
+    """Return None when there is no list for the requested division in the cited passages."""
+    if not isinstance(constraints, dict):
+        return None
+    segment = constraints.get("business_scope")
+    if not isinstance(segment, str) or not segment.strip():
+        return None
+    segment = segment.strip().casefold()
+    issuer = constraints.get("entity")
+    period = constraints.get("period_start"), constraints.get("period_end")
+    basis = str(constraints.get("basis", "")).casefold().replace("-", "").replace(" ", "")
+    found = False
+    eligible = set()
+    for doc in citations:
+        if doc.get("kind") != "document" or doc.get("stale"):
+            continue
+        text = doc.get("text", "")
+        if "respectively" not in text.casefold():
+            continue
+        rows = [r for r in disclosed_rates(text) if r[0] == segment]
+        if not rows:
+            continue
+        found = True
+        if not issuer or doc.get("entity") != issuer or not period[1]:
+            continue
+        for _, dates, label, rate in rows:
+            if not _period_matches(dates, period, assertion):
+                continue
+            if label == "adjusted" and basis in {"adjusted", "nongaap", "adjustednongaap"}:
+                eligible.add(rate)
+            if label == "gaap" and basis in {"gaap", "usgaap", "reported"}:
+                eligible.add(rate)
+            if label == "reported" and basis in {"reported", "asreported"}:
+                eligible.add(rate)
+            # An unqualified segment measure can itself be non-GAAP, even
+            # when the company also publishes consolidated GAAP margins.
+            # Equating "reported" with GAAP needs an explicit segment basis.
+            if label == "reported" and basis in {"gaap", "usgaap"}:
+                basis_statement = r"\b(?:reported |unadjusted )?segment operating (?:profit |income )?margins? (?:are|is) (?:presented |reported |calculated )?(?:on (?:a |an )?)?(?:U\.?S\.?[- ]+)?GAAP basis\b"
+                if any(doc.get("document_id") and other.get("document_id") == doc["document_id"]
+                       and other.get("snapshot_hash") == doc.get("snapshot_hash") and not other.get("stale")
+                       and other.get("entity") == issuer and re.search(basis_statement, other.get("text", ""), re.I)
+                       for other in citations):
+                    eligible.add(rate)
+    if not found:
+        return None
+    return len(eligible) == 1 and abs(value - next(iter(eligible))) <= tolerance
