+        'operand_ids': ids, 'operand_versions': versions, 'value': json_numeric_value(value),
+        'unit': proof['printed_unit'], 'currency': None, 'printed_scale': proof['scale'],
+        'entity': current['entity'], 'entities': [current['entity']], 'document_id': current['document_id'],
+        'metric': 'selected_printed_row_group_change', 'basis': 'revalidated_original_row_group_change',
+        'business_scope': ' + '.join(labels), 'period_start': current['period_start'], 'period_end': current['period_end'],
+        'comparison_period_start': prior['period_start'], 'comparison_period_end': prior['period_end'],
+        'published_at': max(current['published_at'], prior['published_at']), 'scope_version': scope_version,
+        'formula': 'SUM(' + json_text(labels) + ' current) - SUM(' + json_text(labels) + ' prior)',
+        'source_row_change_proof': proof, 'stale': False,
+        'warnings': ['Arithmetic uses the selected printed row units; business perimeter interpretation needs review.'],
+    }
+    return calculation
+
+
+def calculate(current, prior, labels, data, scope_version):
+    from .statement_row_audit import revalidate_row_audit
+    current, prior = prepare_audits(current, prior, data)
+    return calculation_record(current, prior, labels, scope_version)
+
+
+def prepare_audits(current, prior, data):
+    from .statement_row_audit import revalidate_row_audit
+    originals = {}
+    result = []
+    for row in (current, prior):
+        verified = revalidate_row_audit(row, data, originals)
+        verified['version'] = row.get('version', 1) if verified['id'] == row['id'] else 1
+        result.append(verified)
+    return result
+
+
+def json_text(value):
+    import json
+    return json.dumps(value, ensure_ascii=False)
+
+
+def validate_record(record, records):
+    ids = record.get('operand_ids', [])
+    if len(ids) != 2 or len(set(ids)) != 2 or any(key not in records for key in ids):
+        raise ValueError('Source row change needs its two distinct saved source audits')
+    current, prior = [records[key] for key in ids]
+    expected = calculation_record(current, prior, record['source_row_change_proof']['row_labels'], record.get('scope_version'))
+    from .storage import _RESERVED
+    if record.keys() - expected.keys() - _RESERVED:
+        raise ValueError('Unrecognized source-row calculation definition fields')
+    if any(key not in record or type(record[key]) is not type(value) or record[key] != value
+           for key, value in expected.items()):
+        raise ValueError('Saved row change differs from its exact source rows, units, periods or calculation definition')
+    return Decimal(str(expected['value']))
