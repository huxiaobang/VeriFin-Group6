+        integer=int(value)
+        if abs(integer)>2**53-1:
+            raise ValueError('Printed integer exceeds the exact interoperable JSON numeric range')
+        return integer
+    numeric=float(value)
+    if not math.isfinite(numeric) or Decimal(str(numeric))!=value:
+        raise ValueError('Printed Decimal cannot be represented without changing its JSON numeric value')
+    return numeric
