+"""Explicit ordered, same-quarter segment spread over source-addressed rate cells."""
+from .data import DataError, parse_day
+
+OPERATION = 'segment_rate_spread'
+
+
+def dimensions(a, b):
+    required = ('entity','document_id','table_id','snapshot_hash','snapshot_path','source_url',
+                'published_at','metric','metric_header','unit','basis','period_start','period_end')
+    for field in required:
+        if not a.get(field) or a.get(field) != b.get(field):
+            raise DataError('Segment spread requires the same explicit ' + field + '.')
+    if a['unit'] != '%' or a['metric'] != 'operating_income_margin' or a['metric_header'].casefold() != 'operating margin':
+        raise DataError('Segment spread currently supports directly disclosed operating-margin percentages only.')
+    if a['basis'] not in {'GAAP','issuer_defined_non_GAAP'}:
+        raise DataError('Segment spread requires an explicit common accounting basis.')
+    if not 70 <= (parse_day(a['period_end']) - parse_day(a['period_start'])).days + 1 <= 100:
+        raise DataError('Segment spread requires the same single-quarter duration.')
+    scopes = []
+    for row in (a,b):
+        if row.get('cell_type') != 'segment_percentage_cell' or row.get('operation') or row.get('stale'):
+            raise DataError('Segment spread requires fresh original segment percentage cells, not prose or derived results.')
+        scope = row.get('business_scope')
+        if not isinstance(scope,str) or not scope.strip():
+            raise DataError('Segment spread needs an explicit segment name.')
+        for field in ('business_scope_locator','row_label_locator','metric_header_locator','locator'):
+            if not isinstance(row.get(field),str) or not row[field]:
+                raise DataError('Segment spread is missing an original row/column/scope locator.')
+        if not row.get('cell_locators') or len(row.get('column_header_locators',[])) != 3:
+            raise DataError('Segment spread is missing original value and period-header locators.')
+        expected = 'GAAP' if row['basis']=='GAAP' else 'Non-GAAP Adjusted Measure'
+        if row.get('source_row_label') != expected:
+            raise DataError('Segment row label and accounting basis disagree.')
+        scopes.append(scope)
+    if scopes[0].casefold() == scopes[1].casefold() or a['business_scope_locator'] == b['business_scope_locator']:
+        raise DataError('Select two different explicitly located segments; use a period-change operation for one segment.')
+    return {'business_scope':'ordered_segment_comparison','comparison_scopes':scopes,
+            'comparison_source_document':a['document_id'],'comparison_table':a['table_id'],
+            'comparison_snapshot_hash':a['snapshot_hash'],'comparison_metric_header':a['metric_header'],
+            'comparison_definition':'first source-reported segment margin minus second, same quarter and basis',
+            'period_start':a['period_start'],'period_end':a['period_end'],
+            'entity':a['entity'],'basis':a['basis'],'metric':a['metric']+'_spread','unit':'percentage_points'}
+
+
+def revalidate_source_cell(row, data, cache, *, source_bytes_cache=None):
+    """Bind saved operands back to the integrity-checked original HTML on restarts too."""
