+import copy
+import unittest
+from verifin.revision import _review_delivery, render_candidate
+
+class DeliveryTests(unittest.TestCase):
+    def setUp(self):
+        self.claims = [{"id": "bad", "text": "The component supplied most of growth."},
+                       {"id": "good", "text": "Reported revenue was 100."}]
+        self.original = {"claims": copy.deepcopy(self.claims)}
+        self.feedback = {"review": {"issues": [{"target_id": "bad", "issue_type": "numerical_inconsistency",
+                            "missing_support": "The disclosed contribution is below half."}]}}
+
+    def test_unchanged_target_is_audit_only_other_claim_survives(self):
+        visible, withheld, audit = _review_delivery(self.original, self.claims, self.feedback)
+        self.assertEqual([c["id"] for c in visible], ["good"])
+        self.assertEqual(withheld[0]["claim"], self.claims[0])
+        text = render_candidate({"status": "partial", "stop_reason": "execution_error", "claims": visible,
+                                 "withheld_claims": withheld, "review_delivery": audit})
+        self.assertNotIn(self.claims[0]["text"], text)
+        self.assertIn(self.claims[1]["text"], text)
+        self.assertIn("below half", text)
+
+    def test_changed_target_is_not_declared_repaired(self):
+        revised = copy.deepcopy(self.claims)
+        revised[0]["text"] = "The component supplied 40% of growth."
+        visible, withheld, audit = _review_delivery(self.original, revised, self.feedback)
+        self.assertEqual(visible, revised)
+        self.assertEqual(withheld, [])
+        self.assertEqual(audit["claim_notices"][0]["state"], "changed_not_reverified")
+
+    def test_generic_feedback_does_not_invent_targets(self):
+        feedback = {"review": {"review": "One of the claims is wrong; verify it."}}
+        visible, withheld, audit = _review_delivery(self.original, self.claims, feedback)
+        self.assertEqual(visible, self.claims)
+        self.assertFalse(withheld)
+        self.assertEqual(audit["untargeted_review"], feedback["review"]["review"])
+
+    def test_correct_control_no_objection_not_withheld(self):
+        visible, withheld, audit = _review_delivery(self.original, self.claims, {"review": {"issues": []}})
+        self.assertEqual(visible, self.claims)
+        self.assertFalse(withheld)
+        self.assertFalse(audit["claim_notices"])
+
+    def test_request_omission_does_not_withhold_all_claims(self):
+        feedback = {"review": {"issues": [{"target_id": "r1", "issue_type": "omission"}]}}
