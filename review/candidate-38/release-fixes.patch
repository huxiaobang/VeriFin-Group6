+import copy
+import unittest
+
+from verifin.engine import earlier_evidence_review, review_sources
+
+
+class AdditionalEvidenceReviewTests(unittest.TestCase):
+    def setUp(self):
+        old = {"id": "old", "version": 1, "created_at": "2025-01-01", "stale": False}
+        claim = {"id":"c1", "version":2, "status":"Supported", "text":"The margin was 12%.",
+                 "critic_verdict":{"claim_id":"c1", "status":"Supported"}}
+        self.ctx = {"claims":[claim], "session":{"scope_version":3},
+                    "evidence":[old, dict(old, id="new", created_at="2025-01-03")], "calculations":[]}
+        self.episode = {"id":"e1", "status":"partial", "request":"Which margin?", "stop_reason":"local_context_limit"}
+        snapshot = {"request":"Which margin?", "scope_version":3, "claim_versions":{"c1":2},
+                    "sources":review_sources({"evidence":[old], "calculations":[]}),
+                    "fields":{"issues":[], "request_coverage":[{"part":"p1", "status":"partial",
+                    "claim_id":"c1", "answer_sentence":claim["text"], "missing_support":"Period label missing."}]}}
+        self.event = {"id":"v1", "created_at":"2025-01-02", "episode_id":"e1", "review_snapshot":snapshot}
+
+    def test_reuses_only_a_proven_historical_version(self):
+        prior = earlier_evidence_review(self.event, self.episode, self.ctx)
+        self.assertEqual(prior["claim_versions"], {"c1":2})
+        self.assertEqual(prior["additional_records"], 1)
+        self.assertEqual(prior["answer_parts"]["p1"]["missing_support"], "Period label missing.")
+        self.event["review_snapshot"]["fields"]["issues"] = [{"target_id":"p1", "coverage_error":"reused_answer_sentence"}]
+        self.assertEqual(earlier_evidence_review(self.event, self.episode, self.ctx)["answer_parts"], {})
+
+    def test_changed_old_inputs_or_scope_prevent_attribution(self):
+        changes = [
+            ("old version", lambda c: c["evidence"][0].update(version=2)),
+            ("old source stale", lambda c: c["evidence"][0].update(stale=True)),
+            ("old record removed", lambda c: c["evidence"].pop(0)),
+            ("claim rewritten", lambda c: c["claims"][0].update(version=3)),
+            ("claim stale", lambda c: c["claims"][0].update(stale=True)),
+            ("scope changed", lambda c: c["session"].update(scope_version=4)),
+            ("no new evidence", lambda c: c["evidence"].pop()),
+            ("unknown addition time", lambda c: c["evidence"][-1].pop("created_at")),
+            ("unsupported verdict", lambda c: c["claims"][0]["critic_verdict"].update(status="Insufficient Evidence")),
+        ]
+        for name, change in changes:
+            with self.subTest(name=name):
+                ctx = copy.deepcopy(self.ctx)
+                change(ctx)
+                self.assertIsNone(earlier_evidence_review(self.event, self.episode, ctx))
+        for field, value in (("request", "Different question"), ("id", "different-episode"),
+                             ("draft_reference_issues", [{"target_id":"c1"}])):
+            with self.subTest(field=field):
+                self.assertIsNone(earlier_evidence_review(self.event, dict(self.episode, **{field:value}), self.ctx))
