+"""Prove abbreviation boundaries inside an original financial-statement subject.
+
+This does not equate issuer identities, validate financial claims, or make a
+review complete. Unsupported names and ordinary prose keep normal boundaries.
+"""
+import re
+from collections import Counter
+
+from .reporting_period import ENGLISH_DAY, parse_reported_date
+
+
+_GROUP = r"(?:[ \t]+(?:and|&)[ \t]+(?:Subsidiaries|Subsidiary Companies))?"
+_TITLE = (r"(?:[ \t]+(?:and|&)[ \t]+(?:subsidiaries|subsidiary companies))?\s+"
+          r"(?:condensed\s+)?consolidated\s+(?:balance\s+sheets|statements?\s+of\s+"
+          r"(?:income|operations|earnings|cash\s+flows|comprehensive\s+income))\b")
+_DATED_PREFIX = re.compile(
+    r"\s*For\s+(?:the\s+)?(?:quarter|(?:three|six|nine|twelve)\s+months|year)\s+ended\s+"
+    r"(?P<date>"+ENGLISH_DAY+r")\s*,?\s*",re.I)
+
+
+def catalogue_subject_claims(claims, companies):
+    """Add host-only presentation metadata to copies, never stored source claims."""
+    rows=[row for row in (companies or ()) if isinstance(row,dict)
+          and isinstance(row.get('ticker'),str) and isinstance(row.get('name'),str) and row['name'].strip()]
+    names=Counter(' '.join(row['name'].split()).casefold() for row in rows)
+    tickers=Counter(row['ticker'] for row in rows)
+    by_ticker={row['ticker']:row['name'] for row in rows
+               if names[' '.join(row['name'].split()).casefold()]==1 and tickers[row['ticker']]==1}
+    result=[]
+    for claim in claims:
+        clean={key:value for key,value in claim.items()
+               if key not in {'_coverage_issuer_name','_coverage_issuer_name_origin'}}
+        dimensions=claim.get('constraints')
+        entity=dimensions.get('entity') if isinstance(dimensions,dict) else None
+        if entity in by_ticker:
+            clean['_coverage_issuer_name']=by_ticker[entity]
+            clean['_coverage_issuer_name_origin']='unique_host_catalogue'
+        result.append(clean)
+    return result
+
+
+def source_confirmed_subject_spans(claim, records=()):
+    source=claim.get('text','')
+    dims=claim.get('constraints')
+    if not isinstance(source,str) or not isinstance(dims,dict) or not isinstance(dims.get('entity'),str):
+        return []
+    references=claim.get('evidence_ids') or ()
+    if not isinstance(references,(list,tuple)) or not all(isinstance(ref,str) for ref in references):
+        return []
+    refs=set(references)
+    documents=[row for row in (records or ()) if isinstance(row,dict) and row.get('id') in refs
+               and row.get('kind')=='document' and not row.get('stale')
+               and type(row.get('version')) is int and row['version']>0
+               and row.get('entity')==dims['entity'] and row.get('mode') in {'replay','live'}
+               and isinstance(row.get('snapshot_hash'),str) and re.fullmatch(r'[0-9a-fA-F]{64}',row['snapshot_hash'])
+               and isinstance(row.get('text'),str)]
+    if not documents:
+        return []
+    expected=claim.get('_coverage_issuer_name')
+    if (claim.get('_coverage_issuer_name_origin')!='unique_host_catalogue'
+            or not isinstance(expected,str) or not expected.strip() or len(expected)>200):
+        return []
+    literal_name=r'\s+'.join(re.escape(part) for part in expected.split())
+    subject=re.compile(r'(?P<name>'+literal_name+_GROUP+r')'
+                       r'(?P<continuation>[ \t]+(?-i:reported|reports|presented|disclosed|recorded)\b)',re.I)
+    spans=[]
+    for match in subject.finditer(source):
+        prefix=source[:match.start('name')]
+        if prefix.strip():
+            dated=_DATED_PREFIX.fullmatch(prefix)
+            if dated is None or parse_reported_date(dated['date'])!=dims.get('period_end'):
+                continue
+        name=match['name']
+        # Exact punctuation/name, allowing only presentation case/whitespace,
+        # must directly precede a statement title in a cited original. A mere
+        # prose mention or an uncited document is not a formal-name proof.
+        literal=r'\s+'.join(re.escape(part) for part in name.split())
+        pattern=re.compile(r'(?<![A-Za-z0-9])'+literal+_TITLE,re.I)
+        if any(pattern.search(row['text']) for row in documents):
+            # Include the following reporting verb only to cover whitespace
+            # after a terminal Inc./Corp. inside this grammatical subject.
+            # A real sentence ending after the verb remains outside the span.
+            spans.append((match.start('name'),match.end('continuation')))
+    return spans
+
+
+def source_confirmed_label_spans(claim, records=()):
+    """Protect initialisms inside exact cited scope/metric labels, not prose.
+
+    This only preserves sentence boundaries. It neither assigns an answer to a
+    question nor validates the label's financial meaning.
+    """
+    text = claim.get("text", "")
+    dims = claim.get("constraints")
+    refs = claim.get("evidence_ids")
+    if (not isinstance(text, str) or not isinstance(dims, dict)
+            or not isinstance(dims.get("entity"), str)
+            or not isinstance(refs, list) or not all(isinstance(ref, str) for ref in refs)):
+        return []
+    documents = [row for row in records if isinstance(row, dict)
+                 and row.get("id") in refs and row.get("kind") == "document"
+                 and not row.get("stale") and row.get("entity") == dims["entity"]
+                 and row.get("mode") in {"replay", "live"}
+                 and type(row.get("version")) is int and row["version"] > 0
+                 and isinstance(row.get("snapshot_hash"), str)
+                 and re.fullmatch(r"[0-9a-fA-F]{64}", row["snapshot_hash"])
+                 and isinstance(row.get("text"), str)]
+    spans = []
+    for key in ("business_scope", "metric"):
+        label = dims.get(key)
+        if not isinstance(label, str) or not 1 <= len(label) <= 200:
+            continue
+        # The initialism must be internal to the source label, followed by a
+        # word in that same label. A sentence ending in an initialism stays a
+        # real boundary; no punctuation is deleted from the original text.
+        if not re.search(r"\b(?:[A-Z]\.){2,}[ \t]+[A-Za-z]", label):
+            continue
+        literal = r"\s+".join(re.escape(word) for word in label.split())
+        pattern = re.compile(r"(?<![A-Za-z0-9])" + literal + r"(?![A-Za-z0-9])")
+        if any(pattern.search(row["text"]) for row in documents):
+            spans.extend(match.span() for match in pattern.finditer(text))
+    return spans
