+"""Same-window monetary differences over freshly revalidated native statement rows.
+
+No issuer-concept wildcard is additive. The registered original statement reader
+must independently reproduce each selected record before this exception applies.
+"""
+from .data import DataError, parse_day, stable_id
+
+
+PAIR_FIELDS = ('entity','document_id','snapshot_path','snapshot_hash','source_url','published_at',
+               'text_snapshot_path','text_snapshot_hash','table_id','table_xpath','table_title',
+               'table_title_locator','column_headers','column_header_locators','period_start','period_end',
+               'unit','currency','scale','basis','business_scope','printed_scale','printed_unit','unit_locator')
+SOURCE_FIELDS = ('kind','cell_type','mode','document_id','entity','published_at','form','snapshot_hash',
+                 'snapshot_path','source_url','text_snapshot_path','text_snapshot_hash','source_row_start',
+                 'source_row_end','table_id','table_xpath','table_title','table_title_locator','row_label',
+                 'row_label_locator','row_index','locator','column_range_one_based','column_heading',
+                 'column_headers','column_header_locators','printed_value','printed_scale','printed_unit',
+                 'unit_locator','currency_basis','currency_reference','value','currency','unit','scale',
+                 'basis','business_scope','metric','concept','period_start','period_end','printed_week_count',
+                 'period_start_basis','preceding_filing_references')
+
+
+def dimensions(a,b):
+    from .statement_amount_cells import TITLE
+    for row in (a,b):
+        if (row.get('kind')!='financial_fact' or row.get('cell_type')!='statement_amount_cell'
+                or row.get('mode')!='replay' or row.get('operation') or row.get('stale')
+                or type(row.get('version')) is not int or row['version']<1):
+            raise DataError('Source-flow difference requires fresh original statement amount cells, not prose, derived or instant records.')
+        if not row.get('period_start') or not row.get('period_end') or parse_day(row['period_start'])>parse_day(row['period_end']):
+            raise DataError('Source-flow operands require an explicit duration window.')
+        if row.get('instant') or row.get('period_type')=='instant':
+            raise DataError('An instant balance cannot be treated as a statement flow.')
+        if not isinstance(row.get('table_title'),str) or TITLE.fullmatch(row['table_title']) is None:
+            raise DataError('This exception requires an original income-statement table.')
+        if not isinstance(row.get('metric'),str) or row.get('concept')!='issuer:'+row['metric']:
+            raise DataError('This exception only validates the reader-defined issuer flow identity.')
+        if not row.get('currency') or row.get('unit')!=row['currency'] or row.get('scale')!=1:
+            raise DataError('Source-flow operands need a proved common base currency and scale1.')
+    for key in PAIR_FIELDS:
+        if a.get(key) is None or a.get(key)=='' or a.get(key)!=b.get(key):
+            raise DataError('Source-flow difference requires the same original '+key+'.')
+    if (a.get('metric')==b.get('metric') or a.get('locator')==b.get('locator')
+            or a.get('row_label_locator')==b.get('row_label_locator')):
+        raise DataError('Select two distinct, identified flow rows; do not relabel one cell.')
+    return {'method':'regenerated_original_statement_flow_rows','document_id':a['document_id'],
+            'snapshot_hash':a['snapshot_hash'],'table_id':a['table_id'],
+            'period_start':a['period_start'],'period_end':a['period_end'],
+            'currency':a['currency'],'unit':a['unit'],'basis':a['basis'],'business_scope':a['business_scope'],
+            'ordered_rows':[{'id':row['id'],'version':row['version'],'metric':row['metric'],'concept':row['concept'],
+                             'row_label':row.get('row_label'),'row_locator':row.get('row_label_locator'),
+                             'value_locator':row.get('locator')} for row in (a,b)]}
+
+
+def validate_original_pair(a,b,data):
+    proof=dimensions(a,b)
+    originals={}
+    for row in (a,b):
+        key=(row['snapshot_path'],row['entity'],row['published_at'])
+        if key not in originals:
+            matches=[doc for doc in data.manifest['documents'] if doc['source']==key[0]
+                     and doc['entity']==key[1] and doc['published_at']==key[2]]
+            if len(matches)!=1:
+                raise DataError('Flow operand must identify one registered original statement.')
+            doc=matches[0]
+            info=data.info(doc['source'])
+            # Fresh integrity checks apply on every call/restart; no warm parser
+            # cache can substitute for the original source and text snapshot.
+            raw=data.raw(doc['source'])
+            text=data.raw(doc['text']).decode('utf-8')
+            document_id=stable_id('source_doc_',info['url'])
+            try:
+                from .disclosure_cells import _statement_cells
+                generated=_statement_cells(data,raw,doc,info,document_id,text,{})
+            except ImportError:
+                raise DataError('Original statement parser is unavailable; no flow exception was accepted.') from None
+            text_hash=data.info(doc['text'])['sha256']
+            originals[key]=[dict(cell,text_snapshot_hash=text_hash) for cell in generated]
+        found=[cell for cell in originals[key] if cell['id']==row['id']]
+        if len(found)!=1 or any(row.get(field)!=found[0].get(field) for field in SOURCE_FIELDS):
+            raise DataError('Flow operand differs from the independently regenerated original cell, window or unit. Refresh its source cell before calculating.')
+    return proof
