+"""Formal source operand names protect internal dots, never arbitrary U.S. paragraphs."""
+import hashlib
+import unittest
+from verifin.request_review import _review_sentences, grounded_review_rows, report_coverage
+from verifin.tools import ToolRegistry
+from tests.test_segment_rate_spread import OriginalFixtureData
+from tests.test_segment_percentage_cells import HTML
+
+
+class ReviewOperandSentenceTests(unittest.TestCase):
+    def setUp(self):
+        data = OriginalFixtureData()
+        data.raw_bytes = HTML.replace('South Services','U.S. Domestic Services').encode()
+        data.digest = hashlib.sha256(data.raw_bytes).hexdigest()
+        rows = [dict(r,version=1) for r in data.cells()]
+        first = next(r for r in rows if r.get('business_scope')=='North Services' and r['basis']=='GAAP' and r['period_end']=='2025-06-30')
+        second = next(r for r in rows if r.get('business_scope')=='U.S. Domestic Services' and r['basis']=='GAAP' and r['period_end']=='2025-06-30')
+        tools = object.__new__(ToolRegistry)
+        tools.data,tools._percentage_index = data,{}
+        self.calc = tools._calculate_values('segment_rate_spread',[first['id'],second['id']],first,second,{},'2025-07-25',1)['calculations'][0]
+        self.calc['version'] = 1
+        self.records = [first,second,self.calc]
+        self.quote = 'North Services minus U.S. Domestic Services: 12.5% − 6.5% = 6.0 percentage points.'
+        self.source = self.quote + ' The result uses disclosed rounded rates.'
+        self.claim = {'id':'c','text':self.source,'status':'Supported','calculation_ids':[self.calc['id']], 'requirement_ids':[]}
+        self.parts = {'p':'Compare the two segments.'}
+        self.row = {'part':'p','status':'answered','claim_id':'c','answer_sentence':self.quote}
+        self.verdicts = {'c':{'status':'Supported'}}
+
+    def checked(self, row=None, claims=None, records=None):
+        claims = [self.claim] if claims is None else claims
+        records = self.records if records is None else records
+        rows = grounded_review_rows(self.parts,[row or self.row],claims,self.verdicts,'',records=records)
+        return report_coverage(self.parts,rows,claims,reviewed=True,records=records)
+
+    def test_exact_source_name_in_explicit_ordered_operand_label_is_one_sentence(self):
+        self.assertEqual(_review_sentences(self.claim,self.records),[self.quote,'The result uses disclosed rounded rates.'])
+        self.assertEqual(self.checked()[0]['status'],'answered')
+
+    def test_no_source_name_proof_yields_full_supported_text_as_partial(self):
+        row = self.checked(records=[])[0]
+        self.assertEqual(row['status'],'partial')
+        self.assertEqual(row['answer_sentence'],self.source)
+        self.assertIn('complete coverage',row['missing_support'])
+
+    def test_true_sentence_end_us_and_cross_sentence_splice_are_not_accepted(self):
