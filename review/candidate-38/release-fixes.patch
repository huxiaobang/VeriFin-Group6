+import copy
+import unittest
+from tests.test_tools import DATA, MemoryStore
+from verifin.tools import ToolRegistry
+from verifin.verification import check_rules
+
+
+class FractionPointChangeTests(unittest.TestCase):
+    def setUp(self):
+        self.store = MemoryStore()
+        self.tools = ToolRegistry(self.store, DATA)
+        self.facts = {}
+        for year in (2023, 2024):
+            for metric in ("revenue", "operating_income"):
+                result = self.tools.execute("financial_facts", {
+                    "entity": "MSFT", "metric": metric, "period_start": f"{year}-10-01",
+                    "period_end": f"{year}-12-31", "cutoff": "2025-02-28"}, "session", {})
+                self.assertTrue(result["ok"], result)
+                self.store.save(result)
+                self.facts[year, metric] = result["evidence"][0]["id"]
+        self.current, self.prior = self.ratio(2024), self.ratio(2023)
+
+    def calculate(self, operation, first, second):
+        result = self.tools.execute("calculate", {"operation": operation,
+                                    "operand_ids": [first, second]}, "session", {})
+        if result["ok"]:
+            self.store.save(result)
+        return result
+
+    def ratio(self, year, inverse=False):
+        keys = ("revenue", "operating_income") if inverse else ("operating_income", "revenue")
+        result = self.calculate("ratio", *(self.facts[year, key] for key in keys))
+        self.assertTrue(result["ok"], result)
+        return result["calculations"][0]
+
+    def point_change(self):
+        return self.calculate("percentage_point_change", self.current["id"], self.prior["id"])
+
+    def test_existing_percent_and_new_fraction_paths_agree(self):
+        result = self.point_change()
+        self.assertTrue(result["ok"], result)
+        point = result["calculations"][0]
+        self.assertEqual(point["unit"], "percentage_points")
+        self.assertAlmostEqual(point["value"], (self.current["value"] - self.prior["value"]) * 100)
+        margins = [self.calculate("margin", self.facts[year, "operating_income"],
+                                  self.facts[year, "revenue"])["calculations"][0] for year in (2024, 2023)]
+        legacy = self.calculate("percentage_point_change", *(row["id"] for row in margins))
+        self.assertTrue(legacy["ok"], legacy)
+        self.assertAlmostEqual(legacy["calculations"][0]["value"], point["value"])
+        self.assertNotIn("ratio_point_validation", legacy["calculations"][0])
+
+    def test_signed_falling_ratio_and_reversed_time(self):
+        self.current, self.prior = self.ratio(2024, True), self.ratio(2023, True)
+        result = self.point_change()
+        self.assertTrue(result["ok"], result)
+        self.assertLess(result["calculations"][0]["value"], 0)
+        self.assertFalse(self.calculate("percentage_point_change", self.prior["id"], self.current["id"])["ok"])
+
+    def test_wrong_numerator_or_denominator_cannot_hide_behind_metric_text(self):
+        original = copy.deepcopy(self.store.context)
+        for position in (0, 1):
+            with self.subTest(position=position):
+                self.store.context = copy.deepcopy(original)
+                prior = next(row for row in self.store.context["calculations"] if row["id"] == self.prior["id"])
+                other = prior["operand_ids"][1-position]
+                prior["operand_ids"][position] = other
+                prior["operand_versions"] = {other: 1}
+                prior["value"] = 1
+                self.assertFalse(self.point_change()["ok"])
+
+    def test_mixed_scales_changed_values_versions_and_windows_reject(self):
+        original = copy.deepcopy(self.store.context)
+        changes = ({"unit": "%"}, {"operation": None}, {"value": 0.5}, {"operand_versions": {}},
+                   {"period_start": "2024-11-01"}, {"business_scope": "segment"}, {"basis": "adjusted"})
+        for change in changes:
+            with self.subTest(change=change):
+                self.store.context = copy.deepcopy(original)
+                current = next(row for row in self.store.context["calculations"] if row["id"] == self.current["id"])
+                current.update(change)
+                self.assertFalse(self.point_change()["ok"])
+
+    def test_verification_recomputes_scale_and_saved_proof(self):
+        point = dict(self.point_change()["calculations"][0], version=1)
+        claim = {"id": "claim", "text": "The comparable ratio changed.",
+                 "evidence_ids": [], "calculation_ids": [point["id"]]}
+        controls = (("value", point["value"] / 100, "numerical_inconsistency"),
+                    ("ratio_point_validation", {}, "context_mismatch"),
+                    ("metric", "another_ratio_change", "context_mismatch"))
+        for field, value, category in controls:
+            with self.subTest(field=field):
+                altered = dict(point, **{field: value})
+                context = {**self.store.context, "claims": [claim],
+                           "calculations": [row for row in self.store.context["calculations"]
+                                            if row["id"] != point["id"]] + [altered]}
+                findings = check_rules(context)
+                self.assertTrue(any(row["issue_type"] == category for row in findings), findings)
+
+    def test_invalid_fraction_shapes_zero_denominator_and_nonfinite_dependencies_reject(self):
+        original = copy.deepcopy(self.store.context)
+        controls = ({"instant": True}, {"period_type": "instant"}, {"value": True},
+                    {"value": float("inf")}, {"operand_versions": {identifier: True for identifier in self.current["operand_ids"]}})
+        for change in controls:
+            with self.subTest(change=change):
+                self.store.context = copy.deepcopy(original)
+                current = next(row for row in self.store.context["calculations"] if row["id"] == self.current["id"])
+                current.update(change)
+                self.assertFalse(self.point_change()["ok"])
+        for value in (0, float("nan"), float("inf"), True):
+            with self.subTest(denominator=value):
+                self.store.context = copy.deepcopy(original)
+                denominator = next(row for row in self.store.context["evidence"]
+                                   if row["id"] == self.facts[2024, "revenue"])
+                denominator["value"] = value
+                self.assertFalse(self.point_change()["ok"])
+
+    def test_repeated_dependency_graph_has_a_bounded_validation_budget(self):
+        from verifin.data import DataError
+        from verifin.ratio_points import fraction_comparison
+        source = next(row for row in self.store.context["evidence"]
