+import unittest
+try:
+    from lxml import html
+except ImportError:
+    html = None
+from verifin.filing_fiscal_focus import extract
+
+
+@unittest.skipIf(html is None, "optional lxml parser is unavailable")
+class FilingFiscalFocusTests(unittest.TestCase):
+    company = {"ticker": "ABC", "cik": "0000000123"}
+    document = {"entity": "ABC", "form": "10-Q", "period_end": "2026-06-13"}
+
+    def source(self, year="2026", focus="Q2", end="June 13, 2026", instant=False):
+        period = "<xbrli:instant>2026-06-13</xbrli:instant>" if instant else (
+            "<xbrli:startDate>2025-12-28</xbrli:startDate><xbrli:endDate>2026-06-13</xbrli:endDate>")
+        return ("<html xmlns:ix='http://www.xbrl.org/2013/inlineXBRL' "
+                "xmlns:xbrli='http://www.xbrl.org/2003/instance' xmlns:dei='http://xbrl.sec.gov/dei/2026'><body>"
+                "<ix:header><ix:resources><xbrli:context id='c1'><xbrli:entity>"
+                "<xbrli:identifier scheme='http://www.sec.gov/CIK'>0000000123</xbrli:identifier>"
+                "</xbrli:entity><xbrli:period>" + period + "</xbrli:period></xbrli:context>"
+                "</ix:resources><ix:hidden>"
+                f"<ix:nonNumeric name='dei:DocumentFiscalYearFocus' contextRef='c1'>{year}</ix:nonNumeric>"
+                f"<ix:nonNumeric name='dei:DocumentFiscalPeriodFocus' contextRef='c1'>{focus}</ix:nonNumeric>"
+                "</ix:hidden></ix:header>"
+                f"<ix:nonNumeric name='dei:DocumentPeriodEndDate' contextRef='c1'>{end}</ix:nonNumeric>"
+                "<table><tr><td>Net revenue</td><td>100</td></tr></table></body></html>")
+
+    def read(self, source=None, company=None, document=None):
+        return extract(html.fromstring(source or self.source()), company or self.company, document or self.document)
+
+    def test_shared_issuer_context_reports_focus_without_changing_ytd_to_quarter(self):
+        result = self.read()
+        self.assertEqual((result["fy"], result["fp"], result["document_period_end"]), (2026, "Q2", "2026-06-13"))
+        self.assertEqual(result["context_period"], {"start_date": "2025-12-28", "end_date": "2026-06-13"})
+        self.assertNotIn("period_start", result)
+        self.assertIn("not a fact duration", result["selection_role"])
+
+    def test_reported_year_is_not_guessed_from_calendar_year(self):
+        noncalendar = self.source(year="2027").replace("2025-12-28", "2026-06-01").replace("2026-06-13", "2026-11-30").replace("June 13, 2026", "November 30, 2026")
+        self.assertEqual(self.read(noncalendar, document={**self.document, "period_end": "2026-11-30"})["fy"], 2027)
+        self.assertIsNone(self.read(self.source(year="26")))
+
+    def test_wrong_issuer_end_and_cross_context_fields_abstain(self):
+        self.assertIsNone(self.read(company={"ticker": "OTHER", "cik": "0000000999"}))
+        self.assertIsNone(self.read(company={**self.company, "ticker": "OTHER"}))
+        self.assertIsNone(self.read(document={**self.document, "period_end": "2026-06-14"}))
+        self.assertIsNone(self.read(self.source(end="June 14, 2026")))
+        self.assertIsNone(self.read(self.source().replace("2026-06-13</xbrli:endDate>", "2026-06-12</xbrli:endDate>")))
+        split = self.source().replace("name='dei:DocumentFiscalPeriodFocus' contextRef='c1'",
+                                      "name='dei:DocumentFiscalPeriodFocus' contextRef='missing'")
+        self.assertIsNone(self.read(split))
+
+    def test_external_table_namespace_and_non_inline_attributes_cannot_supply_focus(self):
+        external = "<html><body><table><tr><td name='dei:DocumentFiscalYearFocus'>2026</td>" \
+                   "<td name='dei:DocumentFiscalPeriodFocus'>Q2</td>" \
+                   "<td name='dei:DocumentPeriodEndDate'>June 13, 2026</td></tr></table></body></html>"
+        self.assertIsNone(self.read(external))
+        self.assertIsNone(self.read(self.source().replace("http://xbrl.sec.gov/dei/2026", "https://example.invalid/dei/2026")))
+        self.assertIsNone(self.read(self.source().replace("http://www.xbrl.org/2013/inlineXBRL", "https://example.invalid/inlineXBRL")))
+        self.assertIsNone(self.read(self.source().replace("ix:nonNumeric", "span")))
+
+    def test_conflicting_year_duplicate_context_and_dimensions_abstain(self):
+        conflict = "<ix:nonNumeric name='dei:DocumentFiscalYearFocus' contextRef='c1'>2027</ix:nonNumeric>"
+        self.assertIsNone(self.read(self.source().replace("</ix:hidden>", conflict + "</ix:hidden>")))
+        self.assertIsNone(self.read(self.source().replace("</body>", "<div id='c1'></div></body>")))
+        self.assertIsNone(self.read(self.source().replace("</xbrli:entity>", "<xbrli:segment>segment</xbrli:segment></xbrli:entity>")))
+        self.assertIsNone(self.read(self.source().replace("</xbrli:context>", "<xbrli:scenario>other</xbrli:scenario></xbrli:context>")))
+
+    def test_nil_continuation_and_missing_primary_header_abstain(self):
+        for change in ("continuedAt='later'", "xsi:nil='true'"):
+            with self.subTest(change=change):
+                source = self.source().replace("name='dei:DocumentFiscalYearFocus'", change + " name='dei:DocumentFiscalYearFocus'")
+                self.assertIsNone(self.read(source))
+        self.assertIsNone(self.read(self.source().replace("ix:header", "div")))
+
+    def test_instant_context_annual_focus_and_alternate_taxonomy_prefix(self):
+        self.assertEqual(self.read(self.source(instant=True))["context_period"], {"instant": "2026-06-13"})
+        annual = {**self.document, "form": "10-K"}
+        self.assertEqual(self.read(self.source(focus="FY"), document=annual)["fp"], "FY")
+        self.assertIsNone(self.read(self.source(focus="Q2"), document=annual))
+        renamed = self.source().replace("xmlns:dei=", "xmlns:d=").replace("name='dei:", "name='d:")
+        self.assertEqual(self.read(renamed)["fp"], "Q2")
