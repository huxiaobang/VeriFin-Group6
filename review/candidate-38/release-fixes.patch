+"""Exact trusted catalog identity never equates ambiguous or different issuers."""
+import copy
+import unittest
+from verifin.context import canonical_claim_issuers
+
+
+class ClaimIssuerIdentityTests(unittest.TestCase):
+    def context(self, entity="Intuitive Surgical", ticker="ISRG"):
+        return {"claims": [{"id": "c", "constraints": {"entity": entity}, "evidence_ids": ["e"]}],
+                "evidence": [{"id": "e", "entity": ticker}], "calculations": []}
+
+    def test_unique_name_alias_ticker_and_cik(self):
+        catalog = [{"ticker": "ISRG", "name": "Intuitive Surgical", "aliases": ["Intuitive"], "cik": "0001035267"}]
+        for name in ["Intuitive Surgical", "intuitive", "isrg", "1035267", "0001035267"]:
+            with self.subTest(name=name):
+                original = self.context(name)
+                result = canonical_claim_issuers(original, catalog)
+                self.assertEqual(result["claims"][0]["constraints"]["entity"], "ISRG")
+                self.assertEqual(original["claims"][0]["constraints"]["entity"], name)
+
+    def test_wrong_ambiguous_substring_stale_or_missing_citations_do_not_normalize(self):
+        catalog = [{"ticker": "ISRG", "name": "Intuitive Surgical"}]
+        for context, companies in [
+            (self.context(ticker="MSFT"), catalog),
+            (self.context(), catalog + [{"ticker": "OTHER", "name": "Intuitive Surgical"}]),
+            (self.context("Surgical"), catalog),
+            (self.context(), []),
+        ]:
+            with self.subTest(context=context, companies=companies):
+                self.assertEqual(canonical_claim_issuers(context, companies)["claims"], context["claims"])
+        for alteration in ["stale", "missing", "mixed"]:
+            context = self.context()
+            if alteration == "stale":
+                context["evidence"][0]["stale"] = True
+            elif alteration == "missing":
+                context["claims"][0]["evidence_ids"].append("absent")
+            else:
+                context["claims"][0]["evidence_ids"].append("different")
+                context["evidence"].append({"id": "different", "entity": "MSFT"})
+            self.assertEqual(canonical_claim_issuers(context, catalog)["claims"], context["claims"])
+
+    def test_legal_suffix_is_full_token_and_ambiguity_and_classes_survive(self):
+        catalog = [{"ticker": "ISRG", "name": "Intuitive Surgical, Inc."}]
