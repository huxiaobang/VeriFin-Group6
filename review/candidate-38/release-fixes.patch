+"""Conservative shared captions governing a contiguous sibling-table run.
+
+This does not search a document for a convenient date or infer a fiscal calendar.
+Every skipped nonempty block must be a standalone table with the same printed
+period/year header family. The first other block must itself be a short caption.
+"""
+import re
+from lxml import html
+
+DURATION = re.compile(r'^(Three|3|Six|6|Nine|9|Twelve|12) Months$', re.I)
+CAPTION = re.compile(r'\bFor the (Three|3)(?: and (Six|6|Nine|9|Twelve|12))? Months(?: Ended)?\s+', re.I)
+YEAR = re.compile(r'(?:19|20)\d{2}')
+MONTH_DAY = re.compile(r'\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\s+\d{1,2}\b', re.I)
+SCALE = re.compile(r'\(Unaudited\s*[-–—]\s*(Thousands|Millions|Billions) of Dollars\)', re.I)
+
+
+def text(node):
+    return ' '.join(' '.join(node.itertext()).split())
+
+
+def visible(node):
+    return not any(n.get('hidden') is not None or n.get('aria-hidden') == 'true'
+                   or re.search(r'display\s*:\s*none|visibility\s*:\s*hidden', n.get('style', ''), re.I)
+                   or str(n.tag).lower() in {'script', 'style', 'noscript'}
+                   for n in [node, *node.iterancestors(), *node.iterdescendants()])
+
+
+def header_family(table):
+    cells = [text(node) for node in table.xpath('.//td|.//th')]
+    return ({value.lower() for value in cells if DURATION.fullmatch(value)},
+            {value for value in cells if YEAR.fullmatch(value)})
+
+
+def governing_caption(raw, table_locator, group_header, year_header, issuer_names):
+    if not re.fullmatch(r'(?:Three|3) Months', group_header, re.I) or not YEAR.fullmatch(year_header):
+        raise ValueError('Shared caption requires an exact three-month group and printed year')
+    tree = html.fromstring(raw)
+    selected = tree.xpath(table_locator)
+    if len(selected) != 1 or not visible(selected[0]):
+        raise ValueError('Original source table must be unique and visible')
+    target = selected[0]
+    family = header_family(target)
+    if group_header.lower() not in family[0] or year_header not in family[1]:
+        raise ValueError('Selected period/year is absent from the original table')
+    anchor = target
+    # Find a sibling run without crossing a nonempty source block.
+    while anchor.getparent() is not None and anchor.getprevious() is None:
+        anchor = anchor.getparent()
+    previous = anchor.getprevious()
+    tables = []
+    durations = set(family[0])
+    while previous is not None:
+        value = text(previous)
+        if not value:
+            if re.search(r'page-break-(?:before|after)\s*:\s*always', previous.get('style', ''), re.I):
+                break
+            previous = previous.getprevious()
+            continue
+        if not visible(previous):
+            break
+        match = CAPTION.search(value)
+        scale = SCALE.search(value)
+        if match and scale and len(value) <= 300 and len(MONTH_DAY.findall(value)) == 1:
+            if re.search(r'\bweeks?\b|except|per share', value, re.I):
+                break
+            issuer_heading = value[:match.start()].strip()
+            normalized = lambda name: ' '.join(re.findall(r'[^\W_]+', name.casefold(), re.UNICODE))
+            matched = next((name for name in issuer_names if normalized(name) == normalized(issuer_heading)), None)
+            if not matched:
+                break
+            allowed = {part.lower()+' months' for part in (match[1], match[2]) if part}
+            if not durations <= allowed:
+                break
+            return {'text': value, 'locator': tree.getroottree().getpath(previous),
+                    'intervening_table_locators': list(reversed(tables)),
+                    'target_table_locator': table_locator, 'scale_word': scale[1].lower(),
+                    'registered_issuer_name': matched, 'issuer_heading': issuer_heading,
+                    'policy': 'contiguous_sibling_tables_shared_three_month_caption_v1'}
+        nested = previous.xpath('.//table')
+        if str(previous.tag).lower() == 'table':
+            nested = [previous]
+        if (len(nested) != 1 or text(nested[0]) != value or not visible(nested[0])
+                or header_family(nested[0])[1] != family[1]
+                or not family[0] <= header_family(nested[0])[0] or MONTH_DAY.search(value)
+                or re.search(r'\bweeks?\b', value, re.I)):
+            break
+        durations.update(header_family(nested[0])[0])
+        tables.append(tree.getroottree().getpath(nested[0]))
+        previous = previous.getprevious()
+    raise ValueError('No short shared period/unit caption governs this contiguous table run')
