+        self.assertFalse(any(event["type"]=="source_revalidation_deferred" for event in self.store.events(other_sid)))
+        other_focus = next(row for row in self.store.get_context(other_sid)["evidence"] if row["id"]==self.focus["id"])
+        self.assertFalse(other_focus["stale"])
+        self.assertEqual(notes[-1]["field_validation"],"not_performed")
+        self.assertTrue(all(row.get("stale") for _,context in model.calls for row in context["evidence"] if row["id"]==self.focus["id"]))
