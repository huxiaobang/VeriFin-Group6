+            "entities": issuers, "cutoff": finding["cutoff"],
+            "eligible_registered_issuer_site_originals": count}
+
+
+def bound_context(context, selection, catalog):
+    """Intersect with existing host source locks and filter every evidence path."""
+    if selection["request_sha256"] != request_hash(context["episode"]["request"]):
+        raise ValueError("source selection belongs to a different user request")
+    checked = checked_selection(selection["selection"], catalog, context["scope"], identity_only=True)
+    if checked["mode"] == "unrestricted":
+        return context
+    return project_originals(context, checked, catalog)
+
+
+def project_originals(context, checked, catalog):
+    """Project allowed originals, including the empty set for an unavailable URL."""
+    document_ids = {row["document_id"] for row in catalog
+                    if row["document_id"] in checked["document_ids"]
+                    and available_by(row["published_at"], context["scope"].get("cutoff"))
+                    and row.get("snapshot_present", True)}
+    previous = context.get("source_document_scope")
+    if previous:
+        document_ids.intersection_update(previous["document_ids"])
+    originals = {r["document_id"]: r for r in catalog if r["document_id"] in document_ids}
+    evidence = [r for r in context.get("evidence", []) if not r.get("stale")
+                and (doc := originals.get(r.get("document_id")))
+                and r.get("entity") == doc.get("entity")
+                and r.get("source_url") == doc.get("source_url")
+                and bool(doc.get("snapshot_hash")) and r.get("snapshot_hash") == doc["snapshot_hash"]]
+    allowed = {r["id"] for r in evidence}
+    calculations = context.get("calculations", [])
+    while True:
+        old = len(allowed)
+        allowed.update(r["id"] for r in calculations if not r.get("stale") and r.get("operand_ids")
+                       and all(ref in allowed for ref in r["operand_ids"]))
+        if len(allowed) == old:
+            break
+    claims = [r for r in context.get("claims", []) if not r.get("stale")
+              and (r.get("evidence_ids") or r.get("calculation_ids"))
+              and set(r.get("evidence_ids", []) + r.get("calculation_ids", [])) <= allowed]
+    from .context import current_tool_receipts
+    from .source_scope import tool_allowed
+    episode = {k: context["episode"][k] for k in (
+        "id", "request", "status", "budget", "created_at", "model_calls", "tool_calls",
+        "planner_steps", "active_seconds", "usage", "no_progress", "active_claim_ids",
+        "issues", "reviewed", "draft_saved", "answered_requirement_ids",
+        "unanswered_requirement_ids", "summary", "model_mode", "request_id", "user_cutoff",
+        "research_skills", "skill_selection_source", "request_coverage", "draft_attempted",
+        "draft_scope_version", "reviewed_scope_version", "reviewed_claim_ids", "reviewed_requirement_ids")
+        if k in context["episode"]}
