+"""Ordered spreads need original typed segment cells, not prose or time changes."""
+import hashlib
+import unittest
+from verifin.data import DataError, stable_id
+from verifin.segment_rate_spread import dimensions, revalidate_source_cell
+from verifin.table_cells import index_percentages
+from verifin.tools import ToolRegistry
+from tests.test_segment_percentage_cells import HTML, DOCUMENT
+
+
+class OriginalFixtureData:
+    def __init__(self):
+        self.raw_bytes = HTML.encode()
+        self.digest = hashlib.sha256(self.raw_bytes).hexdigest()
+        self.manifest = {"documents":[{"source":"r.html","entity":"EXAMPLE","published_at":"2025-07-25"}]}
+
+    def info(self, name):
+        return {"url":"https://example.test/release","sha256":self.digest}
+
+    def raw(self, name):
+        return self.raw_bytes
+
+    def cells(self):
+        url = self.info("r.html")["url"]
+        metadata = {**DOCUMENT,"id":stable_id("source_doc_",url),"source_url":url,"snapshot_hash":self.digest}
+        return index_percentages(self.raw_bytes,metadata)
+
+
+class SegmentRateSpreadTests(unittest.TestCase):
+    def setUp(self):
+        self.data = OriginalFixtureData()
+        rows = self.data.cells()
+        self.first = next(r for r in rows if r.get("business_scope")=="North Services" and r["basis"]=="GAAP" and r["period_end"]=="2025-06-30")
+        self.second = next(r for r in rows if r.get("business_scope")=="South Services" and r["basis"]=="GAAP" and r["period_end"]=="2025-06-30")
+        self.tools = object.__new__(ToolRegistry)
+        self.tools.data = self.data
+        self.tools._percentage_index = {}
+
+    def calculate(self, first=None, second=None, operation="segment_rate_spread"):
+        a,b = first or self.first,second or self.second
+        return self.tools._calculate_values(operation,[a["id"],b["id"]],a,b,{a["id"]:a,b["id"]:b},"2025-07-25",1)
+
+    def test_ordered_spread_reverses_without_becoming_a_time_change(self):
+        calc = self.calculate()["calculations"][0]
+        self.assertEqual(calc["value"],6.0)
+        self.assertEqual(calc["unit"],"percentage_points")
+        self.assertEqual(calc["comparison_scopes"],["North Services","South Services"])
+        self.assertEqual(calc["business_scope"],"ordered_segment_comparison")
+        reverse = self.calculate(self.second,self.first)["calculations"][0]
+        self.assertEqual(reverse["value"],-6.0)
+        self.assertNotEqual(calc["id"],reverse["id"])
+
+    def test_wrong_issuer_period_basis_definition_or_origin_rejected(self):
+        changes = {"entity":"OTHER","period_end":"2025-09-30","basis":"issuer_defined_non_GAAP","table_id":"other","document_id":"other","snapshot_hash":"other","unit":"ratio","metric_header":"Gross Margin","cell_type":"document","business_scope":self.first["business_scope"],"business_scope_locator":""}
+        for field,value in changes.items():
+            with self.subTest(field=field),self.assertRaises(DataError):
+                self.calculate(second={**self.second,field:value})
+
+    def test_forged_value_or_label_cannot_pass_original_source_revalidation(self):
+        for field,value in [("value",99.0),("business_scope","Invented Segment"),("source_row_label","GAAP Other"),("locator","/missing")]:
+            with self.subTest(field=field),self.assertRaises(DataError):
+                revalidate_source_cell({**self.second,field:value},self.data,{})
+
+    def test_cold_cache_restart_still_revalidates_original_source(self):
+        revalidate_source_cell(self.first,self.data,{})
+        revalidate_source_cell(self.second,self.data,{})
+        self.assertEqual(dimensions(self.first,self.second)["comparison_scopes"],["North Services","South Services"])
+
+    def test_original_operations_still_reject_cross_segment_inputs(self):
+        for operation in ["difference","percentage_point_change"]:
+            with self.subTest(operation=operation),self.assertRaises(DataError):
+                self.calculate(operation=operation)
