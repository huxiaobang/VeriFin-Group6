+        caption=captions[0]
+        # A statement title and its unit note can be two paragraphs in one caption.
+        # Keep the locator and text of the note so it can be re-opened verbatim.
+        blocks=caption.findall('p') or [caption]
+        for block in blocks:
+            note=' '.join(' '.join(block.itertext()).split())
+            units=re.findall(r'\b(?:millions|billions|thousands)\b',note,re.I)
+            if not units:
