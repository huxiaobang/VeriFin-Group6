+"""Bounded native pre-tax reconciliation cells with an independent dated-table witness.
+
+A short Q label never creates a calendar date by itself. The same original must
+also disclose a dated quarter, the identical short label and all three ordered
+pre-tax amounts under their accounting roles. No ISO currency is inferred.
+"""
+import calendar
+from datetime import date
+from decimal import Decimal
+import re
+
+from .data import DataError, source_table_id, stable_id
+
+CELL_TYPE = 'pretax_reconciliation_cell'
+ROLES = {'as reported (gaap)': 'reported_gaap', 'specified items': 'specified_items',
+         'as adjusted': 'excluding_specified_items', 'excluding specified items': 'excluding_specified_items'}
+MEASURE = re.compile(r'(?:pre[- ]tax income|(?:earnings|income) before (?:income )?taxes)', re.I)
+QUARTER = re.compile(r'([1-4])Q(\d{2})')
+DATED = re.compile(r'(First|Second|Third|Fourth) Quarter Ended ([A-Za-z]+) (\d{1,2}),? ((?:19|20)\d{2})(?: and ((?:19|20)\d{2}))?', re.I)
+UNIT = re.compile(r'\(\s*\$\s+in (millions|thousands|billions)\s*\)', re.I)
+SCALES = {'millions': 10**6, 'thousands': 1000, 'billions': 10**9}
+
+
+def _number(value):
+    from .statement_amount_cells import AMOUNT
+    match = AMOUNT.fullmatch(value)
+    if not match or match['symbol']:
+        return None
+    return Decimal(match['amount'].replace(',', '').replace('−', '-').replace('(', '-').replace(')', ''))
+
+
+def _row_index(rows, node):
+    return next(index for index, row in enumerate(rows) if any(cell is node for _, _, cell in row))
+
+
+def _one_amount(row, interval):
+    nonempty = [(span, value, node) for span, value, node in row
+                if value and span.start < interval.stop and interval.start < span.stop]
+    numeric = [(span, value, node) for span, value, node in nonempty if _number(value) is not None]
+    if len(numeric) != 1 or any(value not in {'$', numeric[0][1]} for _, value, _ in nonempty):
+        return None
+    span, printed, node = numeric[0]
+    if span.start < interval.start or span.stop > interval.stop:
+        return None
+    return span, printed, node
+
+
+def _dated_witnesses(tables, paths, companies):
+    from .statement_amount_cells import nearby, text, SCALE_NOTE
+    witnesses = []
+    for table, rows in tables:
+        notes = nearby(table)
+        titles = [node for node in notes if re.fullmatch(r'Non-GAAP Reconciliation of Financial Information', text(node), re.I)]
+        dates = [(node, DATED.fullmatch(text(node))) for node in notes if DATED.fullmatch(text(node))]
+        issuers = [(node, company) for node in notes for company in companies
+                   if text(node).casefold() in {str(company.get('name') or '').casefold(),
+                                               (str(company.get('name') or '')+' and Subsidiaries').casefold()}]
+        if len(titles) != 1 or len(dates) != 1 or len(issuers) != 1:
+            continue
+        scales = {match[1].lower() for node in notes for match in SCALE_NOTE.finditer(text(node))}
+        if len(scales) != 1:
+            continue
+        witness_scale = SCALES[scales.pop()]
+        date_node, full_date = dates[0]
+        period_headers = [(span, value, node) for row in rows for span, value, node in row if QUARTER.fullmatch(value)]
+        role_headers = [(span, value, node) for row in rows for span, value, node in row if value.casefold() in ROLES]
+        metrics = [row for row in rows if row and MEASURE.fullmatch(row[0][1])]
+        if len(period_headers) != 1 or len(role_headers) != 3 or len(metrics) != 1:
+            continue
+        period_span, short_label, period_node = period_headers[0]
+        if not (_row_index(rows, period_node) < min(_row_index(rows, node) for _, _, node in role_headers)
+                <= max(_row_index(rows, node) for _, _, node in role_headers) < _row_index(rows, metrics[0][0][2])):
+            continue
+        short = QUARTER.fullmatch(short_label)
+        ordinal = ['first', 'second', 'third', 'fourth'].index(full_date[1].lower())+1
+        years = [int(y) for y in (full_date[4], full_date[5]) if y and y.endswith(short[2])]
+        month_names = {name.lower(): index for index, name in enumerate(calendar.month_name) if name}
+        month = month_names.get(full_date[2].lower())
+        if ordinal != int(short[1]) or len(years) != 1 or month != ordinal*3:
+            continue
+        try:
+            ending = date(years[0], month, int(full_date[3]))
+        except ValueError:
+            continue
+        if ending.day != calendar.monthrange(ending.year, month)[1]:
+            continue
+        values = {}
+        for span, label, header in role_headers:
+            value = _one_amount(metrics[0][1:], span)
+            if value is None or span.start < period_span.start or span.stop > period_span.stop:
+                break
+            values[ROLES[label.casefold()]] = {'value': str(_number(value[1])), 'printed_value': value[1],
+                'value_locator': paths[value[2]], 'role_header': label, 'role_locator': paths[header]}
+        if len(values) != 3 or Decimal(values['reported_gaap']['value']) + Decimal(values['specified_items']['value']) != Decimal(values['excluding_specified_items']['value']):
+            continue
+        from .statement_row_audit import json_numeric_value
+        try:
+            for entry in values.values():
+                json_numeric_value(Decimal(entry['value'])*witness_scale)
+        except ValueError:
+            continue
+        witnesses.append({'short_label': short_label, 'period_start': date(ending.year, month-2, 1).isoformat(),
+            'period_end': ending.isoformat(), 'printed_scale': witness_scale, 'date_header': text(date_node), 'date_header_locator': paths[date_node],
+            'period_header_locator': paths[period_node], 'table_xpath': paths[table],
+            'measure': metrics[0][0][1], 'measure_locator': paths[metrics[0][0][2]],
+            'issuer': issuers[0][1]['ticker'], 'business_scope': text(issuers[0][0]),
+            'business_scope_locator': paths[issuers[0][0]], 'ordered_role_values': values})
+    return witnesses
+
+
+def cells(raw, doc, info, document_id, source_text, companies):
+    from lxml import html
+    from .structured_documents import _hidden
+    from .revenue_bridge import layout
+    from .statement_amount_cells import text, row_span
+    tree = html.document_fromstring(raw, parser=html.HTMLParser(encoding="utf-8", no_network=True, remove_comments=True))
+    paths = {node: tree.getroottree().getpath(node) for node in tree.iter()}
+    for node in list(tree.iter()):
+        if _hidden(node) and node.getparent() is not None:
+            node.drop_tree()
+    tables = [(table, [[(span, text(node), node) for span, _, node in row] for row in layout(table)])
+              for table in tree.xpath('//table[not(.//table)]')]
+    witnesses = _dated_witnesses(tables, paths, companies)
+    out = []
+    for table, rows in tables:
+        periods = [(span, value, node) for row in rows for span, value, node in row if QUARTER.fullmatch(value)]
+        measures = [(span, value, node) for row in rows for span, value, node in row if MEASURE.fullmatch(value)]
+        units = [(value, node, UNIT.fullmatch(value)) for row in rows for _, value, node in row if UNIT.fullmatch(value)]
+        role_rows = [(row, ROLES[row[0][1].casefold()]) for row in rows if row and row[0][1].casefold() in ROLES]
+        if len(periods) != 1 or len(measures) != 1 or len(units) != 1 or len(role_rows) != 3:
+            continue
+        ps, short, pn = periods[0]
+        ms, measure, mn = measures[0]
+        if (ms.start < ps.start or ms.stop > ps.stop
+                or not (_row_index(rows, pn) < _row_index(rows, mn)
+                        < min(_row_index(rows, row[0][2]) for row, _ in role_rows))):
+            continue
+        chosen = []
+        for row, role in role_rows:
+            amount = _one_amount(row[1:], ms)
+            offsets = row_span([value for _, value, _ in row if value], source_text)
+            if amount is None or offsets is None:
+                break
+            chosen.append((row, role, amount, offsets))
+        if len(chosen) != 3 or len({role for _, role, _, _ in chosen}) != 3:
+            continue
+        printed_unit, unit_node, unit_match = units[0]
+        scale = SCALES[unit_match[1].lower()]
+        matching = [w for w in witnesses if w['short_label'] == short and w['issuer'] == doc['entity'] and w['printed_scale'] == scale
+                    and all(w['ordered_role_values'][role]['value'] == str(_number(amount[1]))
+                            for _, role, amount, _ in chosen)]
+        if len(matching) != 1:
+            continue
+        witness = matching[0]
+        for row, role, (span, printed, node), offsets in chosen:
+            from .statement_row_audit import json_numeric_value
+            value = json_numeric_value(_number(printed)*scale)
+            out.append({'id': stable_id('cell_', [document_id, info['sha256'], paths[node]]),
+                'kind': 'financial_fact', 'cell_type': CELL_TYPE, 'mode': 'replay', 'entity': doc['entity'],
+                'document_id': document_id, 'source_url': info['url'], 'snapshot_hash': info['sha256'],
+                'snapshot_path': doc['source'], 'text_snapshot_path': doc['text'],
+                'published_at': doc['published_at'], 'table_id': source_table_id(document_id, info['sha256'], paths[table]),
+                'table_xpath': paths[table], 'locator': paths[node], 'row_label': row[0][1],
+                'row_label_locator': paths[row[0][2]], 'reconciliation_role': role,
+                'metric': 'pretax_income_'+role, 'concept': 'issuer:pretax_income_'+role,
+                'measure': 'pretax_income', 'measure_header': measure, 'measure_header_locator': paths[mn],
+                'period_label': short, 'period_header_locator': paths[pn],
+                'column_range_one_based': [span.start+1, span.stop],
+                'source_row_start': offsets[0], 'source_row_end': offsets[1],
+                'printed_value': printed, 'printed_unit': printed_unit, 'unit_locator': paths[unit_node],
+                'printed_scale': scale, 'value': value,
+                'unit': 'source_dollar', 'currency': None, 'scale': 1,
+                'currency_basis': 'Printed dollar symbol only; ISO currency not established',
+                'basis': 'issuer_disclosed_pretax_reconciliation', 'business_scope': witness['business_scope'],
+                'period_start': witness['period_start'], 'period_end': witness['period_end'], 'date_witness': witness})
+    return out
+
+
+def dimensions(a, b):
+    """A local symbolic dollar unit cancels only within this exact proved table."""
+    fields = ('entity', 'document_id', 'snapshot_path', 'snapshot_hash', 'source_url', 'published_at',
+              'text_snapshot_path', 'text_snapshot_hash', 'table_id', 'table_xpath', 'measure',
+              'measure_header', 'measure_header_locator', 'period_label', 'period_header_locator',
+              'period_start', 'period_end', 'unit', 'printed_unit', 'unit_locator', 'printed_scale',
+              'basis', 'business_scope', 'date_witness')
+    for row in (a, b):
+        if (row.get('cell_type') != CELL_TYPE or row.get('kind') != 'financial_fact'
+                or row.get('operation') or row.get('stale') or row.get('instant')
+                or row.get('period_type') == 'instant' or row.get('mode') != 'replay'
+                or row.get('unit') != 'source_dollar' or row.get('currency') is not None
+                or row.get('scale') != 1 or row.get('measure') != 'pretax_income'
+                or row.get('reconciliation_role') not in set(ROLES.values())
+                or row.get('metric') != 'pretax_income_'+row.get('reconciliation_role', '')
+                or row.get('concept') != 'issuer:'+row.get('metric', '')
+                or type(row.get('version')) is not int or row['version'] < 1):
+            raise DataError('Use fresh original pre-tax reconciliation cells with their printed symbolic unit; no ISO currency is inferred.')
