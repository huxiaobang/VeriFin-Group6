+        self.assertTrue(self.store.get_context(self.sid,report_mode="none")["evidence"][0]["stale"])
+        with self.assertRaises(ValueError):
+            self.store.invalidate_evidence_version(self.sid,self.cell["id"],99,"test")
+
+    def test_saved_request_retrieval_does_not_revalidate_or_rewrite_report(self):
+        from tests.test_engine import ScriptedModel, FixtureTools, full_script
