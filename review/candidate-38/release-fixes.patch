+"""Allowlisted role-failure diagnostics shared by Markdown and local web views."""
+import re
+
+from .model import ModelError
+
+
+ROLES = {"planner": "Planner", "researcher": "Researcher", "critic": "Critic"}
+
+
+def uses_chinese_display(report):
+    return bool(re.search(r"[\u3400-\u9fff]", str(report.get("request", ""))))
+
+
+def failure_metadata(role, error):
+    """Keep a typed deadline code; never persist arbitrary exception text or hints."""
+    if (role not in ROLES or not isinstance(error, ModelError)
+            or not isinstance(getattr(error, "code", None), str)
+            or not isinstance(getattr(error, "user_hint", None), str)):
+        return None
+    return {"role": role, "code": "timeout" if getattr(error, "code", None) == "timeout" else "unclassified"}
+
+
+def failure_presentation(report):
+    if report.get("stop_reason") != "execution_error":
+        return None
+    planner = report.get("planner_error") or {}
+    if (report.get("delivery_stage") == "no_draft" and not report.get("tool_fault")
+            and not report.get("source_coverage_gap") and not report.get("researcher_output_error")
+            and planner.get("error_type") == "OutputContractError"
+            and planner.get("diagnostic_code") == "invalid_role_output"):
+        sequence = planner.get("event_sequence")
+        activity = f" (Activity #{sequence})" if type(sequence) is int and sequence > 0 else ""
+        if uses_chinese_display(report):
+            return {"stage_label": "研究计划未通过检查",
+                    "stage_message": "Planner 返回的下一步操作未通过格式或内容检查。研究在起草前停止，本题尚无已核验的回答。" + activity}
+        return {"stage_label": "Research plan rejected",
+                "stage_message": "The Planner returned a next step that failed validation. "
+                                 "Research stopped before drafting. This question has no verified answer yet." + activity}
+    failure = report.get("model_call_failure")
+    if not isinstance(failure, dict) or failure.get("role") not in ROLES:
+        return None
+    if failure.get("code") not in {"timeout", "unclassified"}:
+        return None
+    role = ROLES[failure["role"]]
+    chinese = uses_chinese_display(report)
+    sequence = failure.get("event_sequence")
+    activity = f" (Activity #{sequence})" if type(sequence) is int and sequence > 0 else ""
+    if chinese:
+        label = "模型调用中断"
+        reason = f"{role} 调用超过本地时限，未取得该次调用的完整回执。" if failure["code"] == "timeout" else f"{role} 调用失败；已保存的诊断不足以确认原因。"
+        detail = "已取得的证据和草稿仍可查阅；本次中断并不代表财务结论已核验。中断调用的用量可能未知。可稍后以新请求明确重试；这条提示不会触发自动重试。"
+    else:
+        label = "Model call interrupted"
+        reason = f"The {role} call exceeded its local deadline; no complete response from that call was accepted." if failure["code"] == "timeout" else f"The {role} call failed; the saved diagnostic does not establish the cause."
+        detail = "Preserved evidence and any draft remain available; the interruption does not verify the financial conclusions. Usage of the interrupted call may be unknown. You can explicitly retry with a new request later; this message does not trigger a retry."
+    return {"stage_label": label, "stage_message": reason + activity + " " + detail}
