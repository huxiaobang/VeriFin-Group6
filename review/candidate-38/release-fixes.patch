+"""Local transport diagnostics; fixture calls do not use a provider or network."""
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+
+from tests.test_engine import FixtureTools, ScriptedModel, full_script
+from verifin.engine import ResearchEngine
+from verifin.model import ModelError, ProviderOutputError
+from verifin.reporting import render_markdown, report_view
+from verifin.role_failures import failure_metadata, failure_presentation
+from verifin.storage import SessionStore
+from verifin.webapp import Application, handler_for
+
+
+class TransportFailure(ModelError):
+    def __init__(self, code):
+        self.code = code
+        self.user_hint = 'DO NOT COPY: private provider material'
+        super().__init__('DO NOT COPY: secret raw exception text')
+
+
+class RoleFailureTests(unittest.TestCase):
+    def run_failure(self, role, request, code='timeout'):
+        script = full_script()
+        position = next(index for index, item in enumerate(script) if item[0] == role)
+        script = script[:position] + [(role, TransportFailure(code))]
+        with tempfile.TemporaryDirectory() as directory:
+            with SessionStore(Path(directory) / 'sessions.sqlite') as store:
+                sid = store.create_session('Transport diagnostic')['id']
+                result = ResearchEngine(store, ScriptedModel(script), FixtureTools()).ask(sid, request)
+                events = store.events(sid)
+        self.assertEqual('execution_error', result['report']['stop_reason'])
+        self.assertEqual('partial', result['status'])
+        metadata = result['report']['model_call_failure']
+        self.assertEqual(role, metadata['role'])
+        self.assertTrue(any(event.get('model_call_failure') == {'role':role, 'code':metadata['code']}
+                            and event['event_sequence'] == metadata['event_sequence'] for event in events))
+        self.assertNotIn('DO NOT COPY', str(result))
+        return result['report']
+
+    def test_each_role_deadline_uses_request_language_in_shared_view_and_markdown(self):
+        for role in ('planner', 'researcher', 'critic'):
+            for request, expected in [('Revenue for MSFT fiscal Q2 2025?', 'local deadline'),
+                                      ('请核验微软同季收入。', '本地时限')]:
+                with self.subTest(role=role, request=request):
+                    report = self.run_failure(role, request)
+                    view = report_view(report)
+                    self.assertIn(role.title(), view['stage_message'])
+                    self.assertIn(expected, view['stage_message'])
+                    self.assertIn(view['stage_message'], render_markdown(report))
+                    self.assertIn('event_sequence', report['model_call_failure'])
+
+    def test_unknown_transport_failure_is_not_guessed_as_deadline(self):
+        report = self.run_failure('researcher', 'Revenue?', 'cli_turn_failed')
+        message = report_view(report)['stage_message']
+        self.assertIn('does not establish the cause', message)
+        self.assertNotIn('deadline', message)
+        self.assertNotIn('network', message)
+
+    def test_raw_message_or_nontransport_error_cannot_manufacture_timeout(self):
+        self.assertIsNone(failure_metadata('planner', ModelError('timeout secret')))
+        self.assertIsNone(failure_metadata('researcher', ProviderOutputError('max_output_tokens')))
+        self.assertIsNone(failure_metadata('external', TransportFailure('timeout')))
+        report = {'request':'Revenue?', 'stop_reason':'execution_error',
+                  'model_call_failure':{'role':'planner','code':'other_timeout_text'}}
+        self.assertIsNone(failure_presentation(report))
+
+    def test_nonerror_report_does_not_show_old_transport_diagnostic(self):
+        report = {'request':'Revenue?', 'stop_reason':'completed',
+                  'model_call_failure':{'role':'critic','code':'timeout'}}
+        self.assertIsNone(failure_presentation(report))
+
+    def test_unknown_or_missing_activity_is_not_invented(self):
+        report = {'request':'Revenue?', 'stop_reason':'execution_error',
+                  'model_call_failure':{'role':'critic','code':'timeout','event_sequence':'private'}}
+        self.assertNotIn('Activity', failure_presentation(report)['stage_message'])
+
+    def test_normal_web_report_and_markdown_routes_share_diagnostic_without_socket(self):
+        with tempfile.TemporaryDirectory() as directory:
+            database = Path(directory) / 'sessions.sqlite'
+            with SessionStore(database) as store:
+                sid = store.create_session('Web diagnostic')['id']
+                model = ScriptedModel([('planner', TransportFailure('timeout'))])
+                ResearchEngine(store, model, FixtureTools()).ask(sid, 'Revenue?')
+            app = Application(database, Path(__file__).resolve().parents[1] / 'data/replay')
+            handler_class = handler_for(app)
+            delivered = {}
+            for route in ('report', 'report.md'):
+                handler = handler_class.__new__(handler_class)
+                handler.server = SimpleNamespace(server_port=8765)
+                handler.headers = {'Host':'127.0.0.1:8765'}
+                handler.path = f'/api/session/{sid}/{route}'
+                handler.send = lambda status, body, *args, **kwargs: delivered.update(status=status, body=body)
+                handler.do_GET()
+                self.assertEqual(200, delivered['status'])
+                if route == 'report':
+                    shared_message = delivered['body']['stage_message']
+                    self.assertIn('Planner call exceeded its local deadline', shared_message)
+                else:
+                    self.assertIn(shared_message, delivered['body'])
+
