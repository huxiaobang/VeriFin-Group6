+"""Reconstruct a period amount from three physical rows in the same disclosure column."""
+from decimal import Decimal
+import re
+
+from .data import DataError, stable_id
+from .structured_documents import parse_structured_html
+from .table_cells import _rows_with_columns, column_period
+
+
+
+DAILY = re.compile(r"Average Daily (.+?) Volume \(in (thousands|millions)\)", re.I)
+RATE = re.compile(r"(.+?) (?:Non-GAAP Adjusted )?Cost Per (?:Piece|Package)(?: \(GAAP\))?", re.I)
+DURATION = re.compile(r"(?:Three|Six|Nine|Twelve) Months Ended", re.I)
+MONTH_DAY = re.compile(r"[A-Z][a-z]+ [0-9]{1,2},?", re.I)
+NUMBER = re.compile(r"(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?")
+CURRENCY = re.compile(r"(?:USD|CAD|C\$|US\$|\$|€|£)")
+SCALES = {"thousands": 1_000, "millions": 1_000_000}
+
+
+def selected_row(rows, label):
+    matches = [row for row in rows if row and row[0][0] == 0 and row[0][1]["text"] == label]
+    return matches[0] if len(matches) == 1 else None
+
+
+def inputs(raw, doc, volume_row, rate_row, start, end):
+    """Return only a unique physical table/column matching the selected row labels and dates."""
+    from .statement_row_audit import json_numeric_value
+    volume = DAILY.fullmatch(volume_row)
+    rate = RATE.fullmatch(rate_row)
+    if (not volume or not rate or volume[1].casefold() != rate[1].casefold()
+            or volume[1].split()[-1].casefold() not in {"package", "piece"}):
+        raise DataError("Choose matching business-scope rows for average daily volume and cost per piece.")
+    tables = parse_structured_html(raw, source_url=doc["source_url"], document_id=doc["id"],
+                                   snapshot_path=doc["snapshot_path"])
+    candidates = []
+    for table in tables["tables"]:
+        if table["status"] != "parsed":
+            continue
+        rows = list(_rows_with_columns(table))
+        days = selected_row(rows, "Operating Days")
+        quantities = selected_row(rows, volume_row)
+        rates = selected_row(rows, rate_row)
+        if not all((days, quantities, rates)):
+            continue
+        first_input = min(row[0][1]["source_row"] for row in (days, quantities, rates))
+        heads = [(at, c) for row in rows for at, c in row if c["source_row"] < first_input]
+        for col, year in heads:
+            if not re.fullmatch(r"(?:19|20)[0-9]{2}", year["text"]):
+                continue
+            above = [c for at, c in heads if at <= col < at+c["colspan"] and c["source_row"] < year["source_row"]]
+            groups = [c for c in above if DURATION.fullmatch(c["text"])]
+            dates = [c for c in above if MONTH_DAY.fullmatch(c["text"])]
+            if len(groups) != 1 or len(dates) != 1:
+                continue
+            period = column_period([groups[0]["text"], dates[0]["text"], year["text"]])
+            if period != (start, end):
+                continue
+            unit_cell = next((c for at,c in rates if at == col-1 and c["colspan"] == 1), None)
+            if not unit_cell or not CURRENCY.fullmatch(unit_cell["text"]):
+                continue
+            measures = ((days, "operating_days", "days", 1),
+                        (quantities, "average_daily_volume", "pieces_per_operating_day", SCALES[volume[2].lower()]),
+                        (rates, "cost_per_piece", unit_cell["text"]+"_per_piece", 1))
+            cells = []
+            for row, role, unit, scale in measures:
+                cell = next((c for at,c in row if at == col and c["colspan"] == 1), None)
+                suffix = next((c["text"] for at, c in row if at == col + 1), "")
+                if (not cell or not NUMBER.fullmatch(cell["text"])
+                        or re.match(r"^\s*[)%]", suffix)):
+                    break
+                value = Decimal(cell["text"].replace(",", "")) * scale
+                if value <= 0 or (role == "operating_days" and value != value.to_integral_value()):
+                    break
+                source_cell = stable_id("cell_", [doc["snapshot_hash"], table["id"], cell["dom_xpath"]])
+                selection = [volume_row, rate_row, start, end]
+                cell_id = stable_id("unit_input_", [source_cell, selection])
+                label = row[0][1]
+                cells.append({"id":cell_id, "kind":"financial_fact", "cell_type":"per_unit_reconstruction_input",
+                              "selection":selection, "source_cell_id":source_cell, "document_id":doc["id"], "entity":doc["entity"], "snapshot_path":doc["snapshot_path"],
+                              "snapshot_hash":doc["snapshot_hash"], "source_url":doc["source_url"],
+                              "published_at":doc["published_at"], "table_id":table["id"], "locator":cell["dom_xpath"],
+                              "row_label":label["text"], "row_label_xpath":label["dom_xpath"], "column":col,
+                              "header_xpaths":[c["dom_xpath"] for c in (groups[0], dates[0], year)],
+                              "period_start":start, "period_end":end, "metric":label["text"], "unit":unit,
+                              "business_scope":volume[1], "role_in_product":role, "printed_scale":scale,
+                              "printed_value":cell["text"], "value":json_numeric_value(value),
+                              "symbol_locator":unit_cell["dom_xpath"] if role == "cost_per_piece" else None,
+                              "printed_currency":unit_cell["text"] if role == "cost_per_piece" else None,
+                              "text":f"{label['text']} | {groups[0]['text']} {dates[0]['text']} {year['text']} | {cell['text']}",
+                              "mode":"replay", "stale":False})
+            if len(cells) == len(measures):
+                candidates.append(cells)
+    if len(candidates) != 1:
+        raise DataError("The original needs one unambiguous date column with operating days, daily volume and unit cost.")
+    return candidates[0]
+
+
+def reconstruct(data, doc, args):
+    from .statement_row_audit import json_numeric_value
+    selected = (args["volume_row"], args["rate_row"], args["period_start"], args["period_end"])
+    cells = inputs(data.raw(doc["snapshot_path"]), doc, *selected)
+    days, daily, rate = cells
+    value = Decimal(str(days["value"])) * Decimal(str(daily["value"])) * Decimal(str(rate["value"]))
+    ids = [cell["id"] for cell in cells]
+    calculation = {
+        "id": stable_id("calc_", ["printed_daily_volume_times_days_times_unit_cost", ids]),
+        "operation": "printed_daily_volume_times_days_times_unit_cost", "operand_ids": ids,
+        "value": json_numeric_value(value), "unit": rate["printed_currency"], "currency": None,
+        "entity": doc["entity"], "entities": [doc["entity"]], "published_at": doc["published_at"],
+        "period_start": rate["period_start"], "period_end": rate["period_end"],
+        "business_scope": rate["business_scope"], "basis": rate["row_label"],
+        "metric": "period_cost_from_printed_operating_inputs", "formula": " × ".join(ids),
+        "warnings": ["Computed from rounded disclosure inputs. The per-unit measure may exclude costs included in segment expenses."],
+        "stale": False,
+    }
+    return {"evidence": cells, "calculations": [calculation],
+            "summary": f"Reconstructed {rate['printed_currency']}{value:,} from the printed daily volume, operating days and cost per piece.",
+            "data": {"source_rows": [cell["row_label"] for cell in cells], "numeric_operand_ids": ids,
+                     "calculation_id": calculation["id"], "comparison_to_segment_expense": "requires_separate_evidence"}}
+
+
+def revalidate(row, data, rebuilt):
+    from .retrieval import snapshot_document
+    from .storage import _RESERVED
+    selection = tuple(row["selection"])
+    if len(selection) != 4 or not all(isinstance(part, str) for part in selection):
+        raise DataError("A saved unit-cost input lacks its original row and period selection.")
+    key = (row["document_id"], selection)
+    if key not in rebuilt:
+        doc = next((item for item in data.manifest["documents"]
+                    if stable_id("source_doc_", data.info(item["source"])["url"]) == key[0]), None)
+        if doc is None:
+            raise DataError("Saved unit-cost source is missing.")
+        original = snapshot_document(data, doc)
+        rebuilt[key] = {cell["id"]: cell for cell in inputs(data.raw(doc["source"]), original, *selection)}
+    expected = rebuilt[key].get(row["id"])
+    if expected is None or row.keys() - expected.keys() - _RESERVED:
+        raise DataError("Saved unit-cost input does not match the verified original.")
+    for field, value in expected.items():
+        if field != "stale" and (field not in row or type(row[field]) is not type(value) or row[field] != value):
+            raise DataError("Saved unit-cost input differs from its original cell.")
+
+
+def reproduce_product(record, rows):
+    """Independently reconstruct the arithmetic from printed strings and their source dimensions."""
+    days, volume, rate = rows
+    if [row.get("role_in_product") for row in rows] != ["operating_days", "average_daily_volume", "cost_per_piece"]:
+        raise DataError("The unit-cost product requires operating days, daily volume and unit cost in that order.")
+    shared = ("document_id", "entity", "source_url", "snapshot_hash", "table_id", "column",
+              "header_xpaths", "selection", "business_scope", "period_start", "period_end", "published_at")
+    if any(row.get("cell_type") != "per_unit_reconstruction_input" or
+           any(field not in row or row[field] != days.get(field) for field in shared) for row in rows):
+        raise DataError("The reconstruction inputs do not share an original, dated reporting column.")
+    tag = DAILY.fullmatch(volume.get("row_label", ""))
+    rate_tag = RATE.fullmatch(rate.get("row_label", ""))
+    symbol = rate.get("printed_currency", "")
+    if (not tag or not rate_tag or tag[1] != volume["business_scope"] or tag[1].casefold() != rate_tag[1].casefold()
+            or any(row.get("metric") != row.get("row_label") for row in rows)
+            or not CURRENCY.fullmatch(symbol or "") or days["row_label"] != "Operating Days"
+            or days["selection"] != [volume["row_label"], rate["row_label"], days["period_start"], days["period_end"]]):
+        raise DataError("Reconstruction labels or printed currency differ from the selected source rows.")
+    product = Decimal(1)
+    specs = [("days", 1), ("pieces_per_operating_day", SCALES[tag[2].lower()]), (symbol+"_per_piece", 1)]
+    ids = []
+    for row, (unit, scale) in zip(rows, specs):
+        printed = row["printed_value"]
+        if not NUMBER.fullmatch(printed) or row["unit"] != unit or type(row["printed_scale"]) != int or row["printed_scale"] != scale:
+            raise DataError("A unit-cost input does not match its printed value, scale or unit.")
+        value = Decimal(printed.replace(",", "")) * scale
+        if value <= 0 or Decimal(str(row["value"])) != value:
+            raise DataError("A scaled unit-cost input differs from its printed original.")
+        if unit == "days" and value != value.to_integral_value():
+            raise DataError("Operating days must be a whole count.")
+        source_id = stable_id("cell_", [row["snapshot_hash"], row["table_id"], row["locator"]])
+        if row["source_cell_id"] != source_id or row["id"] != stable_id("unit_input_", [source_id, row["selection"]]):
+            raise DataError("The input ID does not identify the selected original cell.")
+        ids.append(row["id"])
+        product *= value
+    expected = {"unit": symbol, "currency": None, "basis":rate["row_label"], "formula":" × ".join(ids),
+                "metric":"period_cost_from_printed_operating_inputs", "operand_ids":ids,
+                "id":stable_id("calc_", [record["operation"], ids]),
+                "operand_versions":{row["id"]: row["version"] for row in rows},
+                "entities":[days["entity"]]}
+    expected.update({k:days[k] for k in ("entity", "business_scope", "period_start", "period_end", "published_at")})
+    if any(k not in record or record[k] != value for k, value in expected.items()):
+        raise DataError("The result dimensions differ from the three selected source cells.")
+    return product
