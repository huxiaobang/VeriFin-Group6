+
+def unavailable_selection(selection, catalog, scope):
+    """Registered metadata audit, separate from financial evidence and verdicts.
+
+    Identity validation is strict even when the chosen original is not usable.
+    Unknown identities are contract errors; they cannot acquire publication dates.
+    Local file presence does not attest its bytes or public availability elsewhere.
+    """
+    checked = checked_selection(selection, catalog, scope, identity_only=True)
+    if checked["mode"] != "only":
+        return None
+    rows = {row["document_id"]: row for row in catalog}
+    selected = [rows[key] for key in checked["document_ids"]]
+    audits = []
+    for row in selected:
+        if not available_by(row["published_at"], scope.get("cutoff")):
+            status = "published_after_cutoff"
+        elif not row.get("snapshot_present", True):
+            status = "local_snapshot_missing"
+        else:
+            return None  # Available originals continue through the ordinary workflow.
+        audits.append({key: row[key] for key in (
+            "document_id", "entity", "form", "source_url", "snapshot_hash",
+            "published_at", "document_report_date", "publication_basis") if key in row})
+        audits[-1]["availability"] = status
+    return {"cutoff": scope.get("cutoff"), "sources": audits} if audits else None
+
+
+def availability_message(audit):
+    lines = ["Source availability check (registered metadata only; no financial figures were verified)."]
+    for row in audit["sources"]:
+        identity = " / ".join(str(row.get(key) or "unspecified") for key in (
+            "entity", "form", "document_report_date"))
+        if row["availability"] == "published_after_cutoff":
+            lines.append(f"{identity}: the registered publication/acceptance time is {row['published_at']}, "
+                         f"after the requested cutoff {audit['cutoff']}. That original is excluded at this cutoff; "
+                         "this run cannot verify its figures from that filing as of then.")
+        else:
+            lines.append(f"{identity}: registered publication time {row['published_at']} is within the cutoff, "
+                         "but its local snapshot is missing. This run cannot inspect the original.")
+    lines.append("This is a finding about the selected registered originals, not a search of all public sources. "
+                 "Earlier reports remain historical records and are not financial evidence for this cutoff.")
+    return " ".join(lines)
