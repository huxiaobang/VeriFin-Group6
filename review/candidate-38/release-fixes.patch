+                                               'header_cells':[{'text':c['text'],'locator':c['dom_xpath']} for row in headers for _,c in row if c['text']],
+                                               'period_header_cells': governing_period_cells(headers, g, y, left, right),
+                                               'group_header':g['text'],'group_locator':g['dom_xpath'],
+                                               'year_header':y['text'],'year_locator':y['dom_xpath'],
+                                               'common_header_interval':[left,right],'cells':cells})
