# Export these in your shell; this file is an example and is not auto-loaded.
VERIFIN_PROVIDER=compatible
VERIFIN_API_MODE=chat_completions
VERIFIN_API_KEY=
VERIFIN_MODEL=
VERIFIN_BASE_URL=
# Copy the actual HTTPS OpenAI-compatible base URL from your workspace.
# Region-specific keys and base URLs must match; /chat/completions is appended.
# Live SEC access is opt-in. Supply a real contact identity.
SEC_USER_AGENT=
# Optional market adapter; used only with --market-config and explicit --live.
ALPHAVANTAGE_API_KEY=
