# Documentation only; not auto-loaded. Export in the terminal running VeriFin.
# First install Codex CLI, then: codex login; codex login status
# Use your own local login; do not paste a token or API key here.
VERIFIN_PROVIDER=codex
VERIFIN_MODEL=gpt-6.1-sol
VERIFIN_REASONING_EFFORT=low
# Optional (defaults shown):
# VERIFIN_TIMEOUT=600
# VERIFIN_CODEX_BINARY=codex
# Clear API-only base URL, API mode, thinking/cache/spend exports before use.
# Uses your account limits; no unlimited-free or API-dollar-cost promise.
# Optional SEC network identity, only when --live is explicitly enabled:
# SEC_USER_AGENT=YourApp your-real-contact@example.com
