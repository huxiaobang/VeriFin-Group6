# Example only: not auto-loaded. Export values in your local shell.
# Do not paste your real key into shared files, screenshots, or the chat.
VERIFIN_PROVIDER=openai
OPENAI_API_KEY=
VERIFIN_MODEL=
# Fill in the exact model ID available to your project after choosing a pilot.
VERIFIN_API_MODE=responses
VERIFIN_REASONING_EFFORT=medium
VERIFIN_MAX_OUTPUT_TOKENS=4096
VERIFIN_MAX_CONTEXT_CHARS=200000
VERIFIN_TIMEOUT=60
# OpenAI provider fixes the base to https://api.openai.com/v1 and tier to default.
# Unset inherited VERIFIN_API_KEY / VERIFIN_BASE_URL / VERIFIN_ENABLE_THINKING
# when switching from another provider. Do not add /responses to the base URL.
